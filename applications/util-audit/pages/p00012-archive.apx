        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            showProcessing: true
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation keep-months-valid (
        name: Months To Keep Is Valid
        execution {
            sequence: 10
        }
        validation {
            type: expression
            language: plsql
            plsqlExpression: validate_conversion(:P12_KEEP_MONTHS as number) = 1 and to_number(:P12_KEEP_MONTHS) >= 1 and to_number(:P12_KEEP_MONTHS) = trunc(to_number(:P12_KEEP_MONTHS))
        }
        error {
            errorMessage: Months to keep must be a whole number, 1 or more.
            displayLocation: inlineWithFieldAndInNotification
            associatedItem: @P12_KEEP_MONTHS
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )


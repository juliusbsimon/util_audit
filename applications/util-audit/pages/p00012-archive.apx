    // P12_ARCHIVE_ID comes from the browser (the row buttons set it), so it
    // is checked here before any row action uses it
    validation archive-id-exists (
        name: Archive File Exists
        execution {
            sequence: 100
        }
        validation {
            type: functionBody
            language: plsql
            plsqlFunctionBody:
                ```plsql
                declare
                    l_found number;
                begin
                    if validate_conversion(:P12_ARCHIVE_ID as number) = 1 then
                        select count(*)
                          into l_found
                          from util_audit_archive_files
                         where archive_id = to_number(:P12_ARCHIVE_ID);
                    end if;
                    if nvl(l_found, 0) = 0 then
                        return 'That archive file does not exist any more. Reload the page and try again.';
                    end if;
                    return null;
                end;
                ```
        }
        error {
            displayLocation: inlineInNotification
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: STORE,PURGE,RESTORE,DOWNLOAD
        }
    )

    dynamicAction show-storage-settings (
        name: Show Storage Settings
        execution {
            sequence: 10
        }
        when {
            event: change
            selectionType: items
            items: [
                P12_STORAGE
            ]
        }

        // Only the settings the chosen storage uses are shown. Hidden fields
        // keep their values and are saved as they are.
        action show-hide-storage-items (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var storage = $v("P12_STORAGE"),
                        shown = {
                            P12_BUCKET:        storage === "AWS4_S3_PKG",
                            P12_CREDENTIAL:    storage === "DBMS_CLOUD",
                            P12_BASE_URI:      storage === "DBMS_CLOUD",
                            P12_PUT_PROCEDURE: storage === "CUSTOM",
                            P12_GET_FUNCTION:  storage === "CUSTOM",
                            P12_PREFIX:        storage !== "DATABASE"
                        };
                    Object.keys(shown).forEach(function (name) {
                        if (shown[name]) {
                            apex.item(name).show();
                        } else {
                            apex.item(name).hide();
                        }
                    });
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: true
            }
        )

    )

    process load-settings (
        name: Load Settings
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Skipped when Save failed validation, so the values the
                -- user entered stay on the page
                :P12_STORAGE       := nvl(util_audit_archive.get_setting('ARCHIVE_STORAGE'), 'DATABASE');
                :P12_BUCKET        := util_audit_archive.get_setting('ARCHIVE_BUCKET');
                :P12_PREFIX        := util_audit_archive.get_setting('ARCHIVE_PREFIX');
                :P12_CREDENTIAL    := util_audit_archive.get_setting('ARCHIVE_CREDENTIAL');
                :P12_BASE_URI      := util_audit_archive.get_setting('ARCHIVE_BASE_URI');
                :P12_PUT_PROCEDURE := util_audit_archive.get_setting('ARCHIVE_PUT_PROCEDURE');
                :P12_GET_FUNCTION  := util_audit_archive.get_setting('ARCHIVE_GET_FUNCTION');
                :P12_KEEP_MONTHS   := nvl(util_audit_archive.get_setting('ARCHIVE_KEEP_MONTHS'), '12');
                :P12_PURGE         := nvl(util_audit_archive.get_setting('ARCHIVE_PURGE'), 'N');
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        serverSideCondition {
            type: request!=Value
            value: SAVE
        }
    )

    process load-schedule (
        name: Load Schedule
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_keep  varchar2(100) := nvl(util_audit_archive.get_setting('ARCHIVE_KEEP_MONTHS'), '12');
                    l_purge varchar2(100) := nvl(util_audit_archive.get_setting('ARCHIVE_PURGE'), 'N');
                begin
                    :P12_JOB_EXISTS   := 'N';
                    :P12_JOB_STATE    := 'Not scheduled';
                    :P12_JOB_INTERVAL := null;
                    :P12_JOB_NEXT_RUN := null;
                    for j in (
                        select enabled, state, repeat_interval, next_run_date
                          from user_scheduler_jobs
                         where job_name = 'UTIL_AUDIT_ARCHIVE_JOB'
                    ) loop
                        :P12_JOB_EXISTS   := 'Y';
                        :P12_JOB_STATE    := case
                                                 when j.enabled = 'TRUE' then 'Scheduled (' || lower(j.state) || ')'
                                                 else 'Disabled'
                                             end;
                        :P12_JOB_INTERVAL := j.repeat_interval;
                        :P12_JOB_NEXT_RUN := to_char(j.next_run_date, 'YYYY-MM-DD HH24:MI TZR');
                    end loop;

                    -- The run log outlives the job, so the last run shows
                    -- even after Stop Schedule
                    :P12_LAST_RUN   := 'Never';
                    :P12_LAST_ERROR := null;
                    for r in (
                        select status,
                               actual_start_date,
                               nvl(errors, additional_info) error_text
                          from user_scheduler_job_run_details
                         where job_name = 'UTIL_AUDIT_ARCHIVE_JOB'
                         order by log_date desc, log_id desc
                         fetch first 1 row only
                    ) loop
                        :P12_LAST_RUN   := initcap(r.status) || ', ' ||
                                           to_char(r.actual_start_date, 'YYYY-MM-DD HH24:MI TZR');
                        :P12_LAST_ERROR := case when r.status <> 'SUCCEEDED' then substr(r.error_text, 1, 4000) end;
                    end loop;

                    -- Keep an interval the user typed (a failed Schedule, say)
                    :P12_REPEAT_INTERVAL := coalesce(:P12_REPEAT_INTERVAL, :P12_JOB_INTERVAL,
                                                     'FREQ=DAILY;BYHOUR=2;BYMINUTE=0');

                    -- Run Now asks with the saved settings, which are what run() uses
                    :P12_RUN_CONFIRM := 'Archive every month older than ' || l_keep ||
                                        case l_keep when '1' then ' month' else ' months' end || ' now?' ||
                                        case when l_purge = 'Y'
                                             then ' Delete archived months is on, so they are also deleted from the audit tables.'
                                        end;
                end;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
    )

    process clear-run-output (
        name: Clear Run Output
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- The Result of Run Now belongs to that one run only.
                -- Runs before validations, so no submit ever shows an older Result.
                :P12_RUN_OUTPUT := null;
                ```
        }
        execution {
            sequence: 5
            point: afterSubmit
        }
    )

    process save-settings (
        name: Save Settings
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                util_audit_archive.set_setting('ARCHIVE_STORAGE',       :P12_STORAGE);
                util_audit_archive.set_setting('ARCHIVE_BUCKET',        trim(:P12_BUCKET));
                util_audit_archive.set_setting('ARCHIVE_PREFIX',        trim(:P12_PREFIX));
                util_audit_archive.set_setting('ARCHIVE_CREDENTIAL',    trim(:P12_CREDENTIAL));
                util_audit_archive.set_setting('ARCHIVE_BASE_URI',      trim(:P12_BASE_URI));
                util_audit_archive.set_setting('ARCHIVE_PUT_PROCEDURE', trim(:P12_PUT_PROCEDURE));
                util_audit_archive.set_setting('ARCHIVE_GET_FUNCTION',  trim(:P12_GET_FUNCTION));
                util_audit_archive.set_setting('ARCHIVE_KEEP_MONTHS',   to_char(to_number(:P12_KEEP_MONTHS)));
                util_audit_archive.set_setting('ARCHIVE_PURGE',         case when :P12_PURGE = 'Y' then 'Y' else 'N' end);
                ```
        }
        execution {
            sequence: 10
            point: processing
        }
        successMessage {
            successMessage: Archive settings saved.
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    process schedule (
        name: Schedule
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    util_audit_archive.schedule(p_repeat_interval => trim(:P12_REPEAT_INTERVAL));
                    apex_application.g_print_success_message := 'Archive job scheduled.';
                exception
                    when others then
                        -- ORA-20052 says which privilege is missing
                        apex_error.add_error(
                            p_message          => 'Scheduling failed: ' || regexp_replace(sqlerrm, '^ORA-2[0-9]{4}: '),
                            p_display_location => apex_error.c_inline_in_notification);
                end;
                ```
        }
        execution {
            sequence: 20
            point: processing
        }
        serverSideCondition {
            whenButtonPressed: @schedule
        }
    )

    process stop-schedule (
        name: Stop Schedule
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    util_audit_archive.unschedule;
                    apex_application.g_print_success_message := 'Archive job stopped.';
                exception
                    when others then
                        apex_error.add_error(
                            p_message          => 'Stopping the job failed: ' || regexp_replace(sqlerrm, '^ORA-2[0-9]{4}: '),
                            p_display_location => apex_error.c_inline_in_notification);
                end;
                ```
        }
        execution {
            sequence: 30
            point: processing
        }
        serverSideCondition {
            whenButtonPressed: @stop-schedule
        }
    )

    process run-now (
        name: Run Now
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_lines  dbms_output.chararr;
                    l_count  integer := 32767;
                    l_error  varchar2(4000);
                    l_output varchar2(32767);
                begin
                    dbms_output.enable(null);
                    begin
                        util_audit_archive.run;
                    exception
                        when others then
                            l_error := sqlerrm;
                    end;
                    dbms_output.get_lines(l_lines, l_count);
                    for i in 1 .. l_count loop
                        if nvl(length(l_output), 0) + nvl(length(l_lines(i)), 0) < 30000 then
                            l_output := l_output || l_lines(i) || chr(10);
                        end if;
                    end loop;
                    dbms_output.disable;
                    if l_error is not null then
                        l_output := l_output || 'ERROR: ' || substr(l_error, 1, 2000);
                    end if;
                    :P12_RUN_OUTPUT := nvl(rtrim(l_output, chr(10)), 'Nothing to archive.');
                    if l_error is null then
                        apex_application.g_print_success_message := 'Archive run finished.';
                    else
                        apex_error.add_error(
                            p_message          => 'The archive run did not finish cleanly: ' ||
                                                  regexp_replace(l_error, '^ORA-2[0-9]{4}: ') || ' See Result for details.',
                            p_display_location => apex_error.c_inline_in_notification);
                    end if;
                end;
                ```
        }
        execution {
            sequence: 40
            point: processing
        }
        serverSideCondition {
            whenButtonPressed: @run-now
        }
    )

    process archive-month (
        name: Archive Month
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_month date := to_date(:P12_ARCH_MONTH, 'YYYY-MM');
                    l_id    number;
                    l_what  varchar2(400) := :P12_ARCH_TABLE || ' ' || to_char(l_month, 'YYYY-MM');
                begin
                    l_id := util_audit_archive.archive_month(:P12_ARCH_TABLE, l_month);
                    if l_id is null then
                        apex_application.g_print_success_message := 'No events in that month: nothing to archive for ' || l_what || '.';
                    else
                        begin
                            util_audit_archive.store(l_id);
                            apex_application.g_print_success_message :=
                                l_what || ' archived and stored as archive ' || l_id || '.';
                        exception
                            when others then
                                apex_error.add_error(
                                    p_message          => l_what || ' was archived as archive ' || l_id ||
                                                          ', but storing it failed: ' || regexp_replace(sqlerrm, '^ORA-2[0-9]{4}: '),
                                    p_display_location => apex_error.c_inline_in_notification);
                        end;
                    end if;
                exception
                    when others then
                        apex_error.add_error(
                            p_message          => 'Archiving ' || l_what || ' failed: ' || regexp_replace(sqlerrm, '^ORA-2[0-9]{4}: '),
                            p_display_location => apex_error.c_inline_in_notification);
                end;
                ```
        }
        execution {
            sequence: 50
            point: processing
        }
        serverSideCondition {
            whenButtonPressed: @archive-month
        }
    )

    // Row actions from the Archive Files report (apex.submit with a request)
    process archive-file-action (
        name: Store, Purge or Restore Archive File
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_id   number := to_number(:P12_ARCHIVE_ID);
                    l_what varchar2(400);
                begin
                    select table_name || ' ' || to_char(period_start, 'YYYY-MM')
                      into l_what
                      from util_audit_archive_files
                     where archive_id = l_id;
                    begin
                        case :REQUEST
                            when 'STORE' then
                                util_audit_archive.store(l_id);
                                apex_application.g_print_success_message := l_what || ' stored.';
                            when 'PURGE' then
                                util_audit_archive.purge(l_id);
                                apex_application.g_print_success_message :=
                                    l_what || ' purged: its events were deleted from the audit tables.';
                            when 'RESTORE' then
                                util_audit_archive.restore(l_id);
                                apex_application.g_print_success_message :=
                                    l_what || ' restored: its events are back in the audit tables.';
                        end case;
                    exception
                        when others then
                            apex_error.add_error(
                                p_message          => initcap(:REQUEST) || ' of ' || l_what || ' failed: ' ||
                                                      regexp_replace(sqlerrm, '^ORA-2[0-9]{4}: '),
                                p_display_location => apex_error.c_inline_in_notification);
                    end;
                end;
                ```
        }
        execution {
            sequence: 60
            point: processing
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: STORE,PURGE,RESTORE
        }
    )

    process download-archive-file (
        name: Download Archive File
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_name util_audit_archive_files.file_name%type;
                    l_file blob;
                begin
                    select file_name
                      into l_name
                      from util_audit_archive_files
                     where archive_id = to_number(:P12_ARCHIVE_ID);
                    l_file := util_audit_archive.get_file(to_number(:P12_ARCHIVE_ID));
                    apex_http.download(
                        p_blob         => l_file,
                        p_content_type => 'application/gzip',
                        p_filename     => l_name);
                    apex_application.stop_apex_engine;
                exception
                    when apex_application.e_stop_apex_engine then
                        raise;
                    when others then
                        apex_error.add_error(
                            p_message          => 'Download failed: ' || regexp_replace(sqlerrm, '^ORA-2[0-9]{4}: '),
                            p_display_location => apex_error.c_inline_in_notification);
                end;
                ```
        }
        execution {
            sequence: 70
            point: processing
        }
        serverSideCondition {
            type: request=Value
            value: DOWNLOAD
        }
    )

    branch go-to-archive (
        name: Go To Archive
        execution {
            sequence: 10
            point: afterProcessing
        }
        behavior {
            type: pageOrUrl
            target: {
                page: 12
            }
        }
    )

)

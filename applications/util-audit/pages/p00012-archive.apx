page 12 (
    name: Archive
    alias: ARCHIVE
    title: Archive
    pageGroup: @administration
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    // A plain form POST on every submit: Download answers the POST with the
    // file itself, which an Ajax submit cannot hand to the browser
    advanced {
        reloadOnSubmit: always
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            // Row actions of the Archive Files report. Store, Purge and Restore
            // change data, so they ask first and then POST the page; nothing
            // changes on a GET. Download needs no confirmation.
            function uaArchiveAction(btn) {
                var action = btn.getAttribute("data-action"),
                    id     = btn.getAttribute("data-id"),
                    esc    = apex.util.escapeHTML,
                    what   = esc(btn.getAttribute("data-table")) + " " + esc(btn.getAttribute("data-month")),
                    text, label, style;

                function go() {
                    apex.submit({ request: action, set: { P12_ARCHIVE_ID: id } });
                }

                if (action === "DOWNLOAD") {
                    go();
                    return;
                }
                if (action === "STORE") {
                    text  = "Store the archive file of " + what + " in the storage set above, then read it back and check it?";
                    label = "Store";
                    style = "information";
                } else if (action === "PURGE") {
                    text  = "Purge " + what + "? The month's events will be deleted from the audit tables. " +
                            "The archive file keeps them, and Restore brings them back.";
                    label = "Purge";
                    style = "danger";
                } else if (action === "RESTORE") {
                    text  = "Restore " + what + "? The file's events are loaded back into the audit tables. " +
                            "Events that are already there are skipped.";
                    label = "Restore";
                    style = "warning";
                } else {
                    return;
                }
                apex.message.confirm(text, function (ok) {
                    if (ok) {
                        go();
                    }
                }, { style: style, confirmLabel: label });
            }
            ```
        executeWhenPageLoads:
            ```javascript-browser
            // Delegated, so the buttons keep working after pagination
            // refreshes the report
            $("#archive_files").on("click", ".ua-archive-action", function () {
                uaArchiveAction(this);
            });
            ```
    }
    security {
        authorizationScheme: @audit-administrator
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: Move old audit history out of the audit tables into archive files (one file per table and month), and bring it back when needed. Choose where the files go and how many months stay in the tables, schedule the archive job or run it now, and store, purge, restore or download each file. Only workspace administrators and developers can use this page.
    }

    region archive (
        name: Archive
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region storage-and-retention (
        name: Storage and Retention
        type: staticContent
        source {
            htmlCode: <p>Where archive files are kept, and how many months of audit history stay in the audit tables. The archive job and the buttons below use the saved values.</p>
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    region schedule (
        name: Schedule
        type: staticContent
        source {
            htmlCode: <p>The database job UTIL_AUDIT_ARCHIVE_JOB archives every month older than the months to keep, stores the files and, when Delete archived months is on, purges them from the audit tables.</p>
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    region archive-a-month-now (
        name: Archive a Month Now
        type: staticContent
        source {
            htmlCode: <p>Builds the archive file of one table and month and stores it. The events stay in the audit tables until you purge the file.</p>
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    region archive-files (
        name: Archive Files
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select archive_id,
                       table_name,
                       to_char(period_start, 'YYYY-MM') month,
                       event_count,
                       record_count,
                       file_bytes,
                       storage,
                       status,
                       initcap(status) status_label,
                       location,
                       message,
                       created_on,
                       to_char(created_on, 'YYYY-MM-DD HH24:MI') created_text,
                       to_char(stored_on, 'YYYY-MM-DD HH24:MI') stored_text,
                       to_char(purged_on, 'YYYY-MM-DD HH24:MI') purged_text,
                       to_char(restored_on, 'YYYY-MM-DD HH24:MI') restored_text,
                       case when status in ('CREATED', 'FAILED') then 'Y' end can_store,
                       case when status = 'STORED' then 'Y' end can_purge,
                       case when status in ('STORED', 'PURGED', 'FAILED') then 'Y' end can_restore,
                       null actions
                  from util_audit_archive_files
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: archive_files
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 25
        }
        messages {
            whenNoDataFound: No archive files yet.
        }

        column ARCHIVE_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 10
            }
        )

        column TABLE_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Table
            }
            layout {
                sequence: 20
            }
            sorting {
                sortable: true
            }
        )

        column MONTH (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Month
            }
            layout {
                sequence: 30
            }
            sorting {

        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            valuePlaceholder: my_pkg.put_file
        }
        help {
            helpText: Your procedure that stores a file, called as proc(p_object_key => ..., p_content => ...) with a VARCHAR2 key and a BLOB.
        }
    )

    pageItem P12_GET_FUNCTION (
        type: textField
        label {
            label: Get function
            alignment: left
        }
        layout {
            sequence: 60
            region: @storage-and-retention
            slot: regionBody
            startNewRow: false
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            valuePlaceholder: my_pkg.get_file
        }
        help {
            helpText: Your function that reads a file back, called as func(p_object_key => ...) and returning the BLOB. Used to check every stored file and to restore and download.
        }
    )

    pageItem P12_PREFIX (
        type: textField
        label {
            label: Prefix
            alignment: left

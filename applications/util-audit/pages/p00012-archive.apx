    validation arch-month-valid (
        name: Archive Month Is Valid
        execution {
            sequence: 90
        }
        validation {
            type: expression
            language: plsql
            plsqlExpression: to_date(:P12_ARCH_MONTH default null on conversion error, 'YYYY-MM') is not null
        }
        error {
            errorMessage: Enter the month to archive as YYYY-MM.
            displayLocation: inlineWithFieldAndInNotification
            associatedItem: @P12_ARCH_MONTH

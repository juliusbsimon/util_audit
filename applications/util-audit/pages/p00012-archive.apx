        layout {
            sequence: 70
            region: @storage-and-retention
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            valuePlaceholder: util_audit/&OWNER.
        }
        help {
            helpText: Folder for the files. Empty means util_audit/ followed by the schema name. Each file goes to prefix/table=TABLE/month=YYYY-MM/file name.
        }
    )

    pageItem P12_KEEP_MONTHS (
        type: numberField
        label {
            label: Months to keep
            alignment: left
        }
        layout {
            sequence: 80
            region: @storage-and-retention
            slot: regionBody
            alignment: left
            columnSpan: 3
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText: The current month and this many months before it stay in the audit tables; the archive job archives older months. With 12, the last full year stays.
        }
    )

    pageItem P12_PURGE (
        type: switch
        label {
            label: Delete archived months
            alignment: left
        }
        layout {
            sequence: 90
            region: @storage-and-retention
            slot: regionBody
            startNewRow: false
            alignment: left
            columnSpan: 3
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        help {
            helpText: When on, the archive job deletes each stored month from the audit tables, so they get smaller. Only turn this on after checking that a restore works with your storage (archive a month, purge it, restore it). When off, the job only copies.
        }
    )

    pageItem P12_JOB_EXISTS (
        type: hidden
        layout {
            sequence: 10
            region: @schedule
            slot: regionBody
        }
        settings {
            valueProtected: true
        }
    )

    pageItem P12_RUN_CONFIRM (
        type: hidden
        layout {
            sequence: 20
            region: @schedule
            slot: regionBody
        }
        settings {
            valueProtected: true
        }
    )

    pageItem P12_JOB_STATE (
        type: displayOnly
        label {
            label: Job
            alignment: left
        }
        layout {
            sequence: 30
            region: @schedule
            slot: regionBody
            alignment: left
            columnSpan: 3
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
            format: plainText
        }
    )

    pageItem P12_JOB_INTERVAL (
        type: displayOnly
        label {
            label: Repeats
            alignment: left
        }
        layout {
            sequence: 40
            region: @schedule
            slot: regionBody
            startNewRow: false
            alignment: left
            columnSpan: 3
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
            format: plainText
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P12_JOB_INTERVAL
        }
    )

    pageItem P12_JOB_NEXT_RUN (
        type: displayOnly
        label {
            label: Next run
            alignment: left
        }
        layout {
            sequence: 50
            region: @schedule
            slot: regionBody
            startNewRow: false
            alignment: left
            columnSpan: 3
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
            format: plainText
        }
        serverSideCondition {
            type: itemIsNotNull

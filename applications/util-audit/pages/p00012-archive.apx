            layout {
                sequence: 60
                columnAlignment: end
            }
            appearance {
                formatMask: FILESIZE
            }
        )

        column STORAGE (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Storage
            }
            layout {
                sequence: 70
            }
        )

        column STATUS (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Status
            }
            layout {
                sequence: 80
            }
            columnFormatting {
                htmlExpression: <span class="ua-archive-status ua-archive-status--#STATUS#">#STATUS_LABEL#</span>
            }
            sorting {
                sortable: true
            }
        )

        column STATUS_LABEL (
            reportColumnQueryId: 9
            derivedColumn: N
            type: hidden
            layout {
                sequence: 90
            }
        )

        column LOCATION (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: Location
            }
            layout {
                sequence: 100
            }
        )

        column MESSAGE (
            reportColumnQueryId: 11
            derivedColumn: N
            heading {
                heading: Message
            }
            layout {
                sequence: 110
            }
        )

        column CREATED_ON (
            reportColumnQueryId: 12
            derivedColumn: N
            heading {
                heading: History
            }
            layout {
                sequence: 120
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <span class="ua-archive-history">Created #CREATED_TEXT#{if STORED_TEXT/}<br>Stored #STORED_TEXT#{endif/}{if PURGED_TEXT/}<br>Purged #PURGED_TEXT#{endif/}{if RESTORED_TEXT/}<br>Restored #RESTORED_TEXT#{endif/}</span>
                    ```
            }
            sorting {
                defaultSequence: 1
                direction: desc
                sortable: true
            }
        )

        column CREATED_TEXT (
            reportColumnQueryId: 13
            derivedColumn: N
            type: hidden
            layout {
                sequence: 130
            }
        )

        column STORED_TEXT (
            reportColumnQueryId: 14
            derivedColumn: N
            type: hidden
            layout {
                sequence: 140
            }
        )

        column PURGED_TEXT (
            reportColumnQueryId: 15
            derivedColumn: N
            type: hidden
            layout {
                sequence: 150
            }
        )

        column RESTORED_TEXT (
            reportColumnQueryId: 16
            derivedColumn: N
            type: hidden
            layout {
                sequence: 160
            }
        )

        column CAN_STORE (
            reportColumnQueryId: 17
            derivedColumn: N
            type: hidden
            layout {
                sequence: 170
            }
        )

        column CAN_PURGE (
            reportColumnQueryId: 18
            derivedColumn: N
            type: hidden
            layout {
                sequence: 180
            }
        )

        column CAN_RESTORE (
            reportColumnQueryId: 19
            derivedColumn: N
            type: hidden
            layout {
                sequence: 190
            }
        )

        // Buttons only; uaArchiveAction (page JavaScript) confirms and submits
        column ACTIONS (
            reportColumnQueryId: 20
            derivedColumn: N
            heading {
                heading: Actions
            }
            layout {
                sequence: 200
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <span class="ua-archive-actions">{if CAN_STORE/}<button type="button" class="t-Button t-Button--small ua-archive-action" data-action="STORE" data-id="#ARCHIVE_ID#" data-table="#TABLE_NAME#" data-month="#MONTH#">Store</button>{endif/}{if CAN_PURGE/}<button type="button" class="t-Button t-Button--small t-Button--danger ua-archive-action" data-action="PURGE" data-id="#ARCHIVE_ID#" data-table="#TABLE_NAME#" data-month="#MONTH#">Purge</button>{endif/}{if CAN_RESTORE/}<button type="button" class="t-Button t-Button--small ua-archive-action" data-action="RESTORE" data-id="#ARCHIVE_ID#" data-table="#TABLE_NAME#" data-month="#MONTH#">Restore</button>{endif/}<button type="button" class="t-Button t-Button--small ua-archive-action" data-action="DOWNLOAD" data-id="#ARCHIVE_ID#" data-table="#TABLE_NAME#" data-month="#MONTH#">Download</button></span>
                    ```
            }
        )

    )

    pageItem P12_STORAGE (
        type: selectList
        label {
            label: Storage
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Database;DATABASE,Amazon S3 via AWS4_S3_PKG;AWS4_S3_PKG,Object storage via DBMS_CLOUD;DBMS_CLOUD,Custom procedure;CUSTOM
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @storage-and-retention
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Database: the files stay in the table UTIL_AUDIT_ARCHIVE_FILES, so the audit tables shrink but the database does not. Amazon S3 via AWS4_S3_PKG: upload to an S3 bucket with the aws4_s3_pkg package in this schema. Object storage via DBMS_CLOUD: upload to S3, OCI Object Storage or Azure with DBMS_CLOUD and a credential. Custom procedure: your own procedure puts each file and your own function reads it back.
        }
    )

    pageItem P12_BUCKET (
        type: textField
        label {
            label: Bucket
            alignment: left
        }
        layout {
            sequence: 20
            region: @storage-and-retention
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText: The S3 bucket that aws4_s3_pkg uploads to. The package must already be set up with its access keys and region.
        }
    )

    pageItem P12_CREDENTIAL (
        type: textField
        label {
            label: Credential
            alignment: left
        }
        layout {
            sequence: 30
            region: @storage-and-retention
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Name of the DBMS_CLOUD credential (created with dbms_cloud.create_credential) that can write to the bucket.
        }
    )

    pageItem P12_BASE_URI (
        type: textField
        label {
            label: Base URI
            alignment: left
        }
        layout {
            sequence: 40
            region: @storage-and-retention
            slot: regionBody
            startNewRow: false
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            valuePlaceholder: https://mybucket.s3.eu-west-1.amazonaws.com
        }
        help {
            helpText: The bucket's URI. Each file goes to this URI followed by the prefix and the file's folder and name.
        }
    )

    pageItem P12_PUT_PROCEDURE (
        type: textField
        label {

        security {
            sessionStateProtection: unrestricted
        }
    )

    button save (
        buttonName: SAVE
        label: Save
        layout {
            sequence: 10
            region: @storage-and-retention
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button run-now (
        buttonName: RUN_NOW
        label: Run Now
        layout {
            sequence: 10
            region: @schedule
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            executeValidations: true
            showProcessing: true
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: &P12_RUN_CONFIRM.
            style: warning
        }
    )

    button stop-schedule (
        buttonName: STOP_SCHEDULE
        label: Stop Schedule
        layout {
            sequence: 20
            region: @schedule
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Stop the archive job? Archive files and settings are kept.
            style: danger
        }
        serverSideCondition {
            type: item=value
            item: P12_JOB_EXISTS
            value: Y
        }
    )

    button schedule (
        buttonName: SCHEDULE
        label: Schedule
        layout {
            sequence: 30
            region: @schedule
            slot: next
        }

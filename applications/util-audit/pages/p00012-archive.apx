            region: @schedule
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
            format: plainText
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P12_LAST_ERROR
        }
    )

    pageItem P12_REPEAT_INTERVAL (
        type: textField
        label {
            label: Repeat interval
            alignment: left
        }
        layout {
            sequence: 80
            region: @schedule
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText: A DBMS_SCHEDULER calendar expression. FREQ=DAILY;BYHOUR=2;BYMINUTE=0 runs every night at 02:00 database time; FREQ=WEEKLY;BYDAY=SUN;BYHOUR=3 runs on Sundays at 03:00.
        }
    )

    pageItem P12_RUN_OUTPUT (
        type: textarea
        label {
            label: Result
            alignment: left
        }
        layout {
            sequence: 90
            region: @schedule
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 8
        }
        readOnly {
            type: always
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P12_RUN_OUTPUT
        }
    )

    pageItem P12_ARCH_TABLE (
        type: selectList
        label {
            label: Table
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @audited-tables
            displayExtraValues: false
            displayNullValue: true
            nullDisplayValue: - Select a table -
        }
        layout {
            sequence: 10
            region: @archive-a-month-now
            slot: regionBody
            alignment: left
            columnSpan: 4
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Tables that have audit events.
        }
    )

    pageItem P12_ARCH_MONTH (
        type: datePicker
        label {
            label: Month
            alignment: left
        }
        layout {
            sequence: 20
            region: @archive-a-month-now
            slot: regionBody
            startNewRow: false
            alignment: left
            columnSpan: 3
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            formatMask: YYYY-MM
        }
        help {
            helpText: The month to archive, as YYYY-MM. Picking any day selects its month. A month can only be archived once; restore its file first to archive it again.
        }
    )

    pageItem P12_ARCHIVE_ID (
        type: hidden
        layout {
            sequence: 10
            region: @archive-files
            slot: regionBody

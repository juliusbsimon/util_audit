    )

    button copy-plugin (
        buttonName: COPY_PLUGIN
        label: Copy Region
        layout {
            sequence: 10
            region: @audit-history-plugin
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction

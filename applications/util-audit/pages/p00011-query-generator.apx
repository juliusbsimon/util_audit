    )

    validation table-required (
        name: Table Required
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P11_TABLE_NAME
        }
        error {
            errorMessage: Choose a table.
            displayLocation: inlineWithFieldAndInNotification
            associatedItem: @P11_TABLE_NAME
        }
        serverSideCondition {
            whenButtonPressed: @generate
        }
    )

    process generate (
        name: Generate
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_cols     varchar2(4000) := replace(:P11_COLUMNS, ':', ',');
                    l_children varchar2(4000) := replace(:P11_CHILD_TABLES, ':', ',');
                begin
                    :P11_ITEMS_TO_SUBMIT := util_audit_query.get_key_items(:P11_TABLE_NAME, :P11_KEY_ITEMS, :P11_PAGE_ID);
                    :P11_FIRST_ITEM := regexp_substr(:P11_ITEMS_TO_SUBMIT, '[^,]+');
                    :P11_SQL := dbms_lob.substr(
                        case when :P11_PLAIN = 'Y' then util_audit_query.get_history_query(
                            p_table_name     => :P11_TABLE_NAME,
                            p_key_items      => :P11_KEY_ITEMS,
                            p_page_id        => :P11_PAGE_ID,
                            p_style          => :P11_STYLE,
                            p_columns        => l_cols,
                            p_child_tables   => l_children,
                            p_schema         => :P11_SCHEMA,
                            p_friendly_names => nvl(:P11_FRIENDLY, 'N'))
                        else util_audit_query.get_history_function_query(
                            p_table_name     => :P11_TABLE_NAME,
                            p_key_items      => :P11_KEY_ITEMS,
                            p_page_id        => :P11_PAGE_ID,
                            p_style          => :P11_STYLE,
                            p_columns        => l_cols,
                            p_child_tables   => l_children,
                            p_schema         => :P11_SCHEMA,
                            p_friendly_names => nvl(:P11_FRIENDLY, 'N')) end, 32000, 1);
                    :P11_APX := dbms_lob.substr(
                        util_audit_apx.get_history_region_apx(
                            p_table_name     => :P11_TABLE_NAME,
                            p_key_items      => :P11_KEY_ITEMS,
                            p_page_id        => :P11_PAGE_ID,
                            p_style          => :P11_STYLE,
                            p_columns        => l_cols,
                            p_child_tables   => l_children,
                            p_schema         => :P11_SCHEMA,
                            p_friendly_names => nvl(:P11_FRIENDLY, 'N')), 32000, 1);
                    :P11_PLUGIN_APX := dbms_lob.substr(
                        util_audit_apx.get_plugin_region_apx(
                            p_table_name     => :P11_TABLE_NAME,
                            p_key_items      => :P11_KEY_ITEMS,
                            p_page_id        => :P11_PAGE_ID,
                            p_style          => :P11_STYLE,
                            p_columns        => l_cols,
                            p_child_tables   => l_children,
                            p_schema         => :P11_SCHEMA,
                            p_friendly_names => nvl(:P11_FRIENDLY, 'N')), 32000, 1);
                    :P11_SAMPLE_KEY := null;
                exception
                    when others then
                        :P11_SQL := null;
                        :P11_APX := null;
                        :P11_PLUGIN_APX := null;
                        -- util_audit_query raises ORA-2xxxx with a plain message
                        apex_error.add_error(
                            p_message          => regexp_replace(sqlerrm, '^ORA-2[0-9]{4}: '),
                            p_display_location => apex_error.c_inline_in_notification);
                end;
                ```
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            whenButtonPressed: @generate
        }
    )

    branch back-to-generator (
        name: Back to Generator
        execution {
            sequence: 10
            point: afterProcessing
        }
        behavior {
            type: pageOrUrl
            target: {
                page: 11
            }
        }
    )

    dynamicAction table-changed (
        name: Table Changed
        execution {
            sequence: 5
        }
        when {
            event: change
            selectionType: items
            items: [
                P11_TABLE_NAME
            ]
        }

        // Output generated for the previous table must never show next to a
        // new table: clear it in session state and hide the output regions
        // until Generate runs again.
        action clear-generated-output (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    :P11_SQL             := null;
                    :P11_APX             := null;
                    :P11_PLUGIN_APX      := null;
                    :P11_ITEMS_TO_SUBMIT := null;
                    :P11_FIRST_ITEM      := null;
                    :P11_SAMPLE_KEY      := null;
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action hide-app-builder-sql (
            action: hide
            affectedElements {
                selectionType: region
                region: @app-builder-sql
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action hide-apexlang-region (
            action: hide
            affectedElements {
                selectionType: region
                region: @apexlang-region
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action hide-audit-history-plugin (
            action: hide
            affectedElements {
                selectionType: region
                region: @audit-history-plugin
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action hide-preview (
            action: hide
            affectedElements {
                selectionType: region
                region: @preview
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action hide-preview-result (
            action: hide
            affectedElements {
                selectionType: region
                region: @preview-result
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
        )

    )

    dynamicAction copy-sql-to-clipboard (
        name: Copy SQL to Clipboard
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @copy-sql
        }

        action copy-sql-js (
            action: executeJsCode
            settings {
                jsCode: navigator.clipboard.writeText(apex.item("P11_SQL").getValue()).then(function () { apex.message.showPageSuccess("SQL copied."); });
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction copy-apx-to-clipboard (
        name: Copy Region to Clipboard
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @copy-apx
        }

        action copy-apx-js (
            action: executeJsCode
            settings {
                jsCode: navigator.clipboard.writeText(apex.item("P11_APX").getValue()).then(function () { apex.message.showPageSuccess("Region copied."); });
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction copy-plugin-to-clipboard (
        name: Copy Plugin Region to Clipboard
        execution {
            sequence: 25
        }
        when {
            event: click
            selectionType: button
            button: @copy-plugin
        }

        action copy-plugin-js (
            action: executeJsCode
            settings {
                jsCode: navigator.clipboard.writeText(apex.item("P11_PLUGIN_APX").getValue()).then(function () { apex.message.showPageSuccess("Region copied."); });
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-preview (
        name: Refresh Preview
        execution {
            sequence: 30
        }
        when {
            event: change
            selectionType: items
            items: [
                P11_SAMPLE_KEY
            ]
        }

        action refresh-preview-result (
            action: refresh
            affectedElements {
                selectionType: region
                region: @preview-result
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

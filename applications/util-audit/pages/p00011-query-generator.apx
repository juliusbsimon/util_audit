            alignment: left
            columnSpan: 4
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Leave empty when your app uses the same schema as util_audit. Otherwise enter the util_audit schema and grant your app's schema EXECUTE on UTIL_AUDIT_QUERY (for plain SQL, SELECT on V_UTIL_AUDIT_ROW_HISTORY, V_UTIL_AUDIT_EVENTS and UTIL_AUDIT_RECORDS instead).
        }
    )

    pageItem P11_PLAIN (
        type: switch
        label {
            label: Plain SQL
            alignment: left
        }
        layout {
            sequence: 65
            region: @settings
            slot: regionBody
            alignment: left
            columnSpan: 4
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: N

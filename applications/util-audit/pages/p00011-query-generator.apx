                select column_name d,
                       column_name r
                  from user_tab_columns
                 where table_name = :P11_TABLE_NAME
                 order by column_id
                ```
        }
        cascadingLov {
            parentItems: [
                P11_TABLE_NAME
            ]
            parentRequired: true
        }
        layout {
            sequence: 70
            region: @settings
            slot: regionBody
            alignment: left
            columnSpan: 8
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Leave empty to show changes to every column.
        }
    )

    pageItem P11_CHILD_TABLES (
        type: selectMany
        label {
            label: Include child tables
            alignment: left

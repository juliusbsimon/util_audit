            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button copy-sql (
        buttonName: COPY_SQL
        label: Copy SQL
        layout {
            sequence: 10
            region: @app-builder-sql
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }

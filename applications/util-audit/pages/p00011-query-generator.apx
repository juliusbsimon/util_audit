    pageItem P11_SAMPLE_KEY (
        type: selectList
        label {
            label: Key
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pk_value_vc d,
                       pk_value_vc r
                  from (select distinct pk_value_vc
                          from util_audit_txn
                         where table_name = :P11_TABLE_NAME)
                 order by 1
                 fetch first 200 rows only
                ```
            displayExtraValues: false
            displayNullValue: true
            nullDisplayValue: - Pick a key -
        }
        cascadingLov {
            parentItems: [
                P11_TABLE_NAME
            ]
            parentRequired: true
        }
        layout {
            sequence: 10
            region: @preview
            slot: regionBody

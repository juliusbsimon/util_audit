page 11 (
    name: Query Generator
    alias: QUERY-GENERATOR
    title: Query Generator
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            .ua-muted { color: var(--ua-text-muted, #6b6e80); }
            .ua-steps li { margin-bottom: .35rem; }
            .ua-steps code { background: var(--ua-row, #f6f7f9); padding: 0 .3rem; border-radius: 4px; }
            ```
    }
    security {
        formAutoComplete: false
    }

    region query-generator (
        name: Query Generator
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region settings (
        name: Settings
        type: staticContent
        source {
            htmlCode: <p class="ua-muted">Builds an Audit History region for a page in another app: the changes recorded for the row that page shows.</p>
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    region app-builder-sql (
        name: SQL for App Builder
        type: staticContent
        source {
            htmlCode:
                ```html
                <ol class="ua-steps">
                <li>Open the page that shows &P11_TABLE_NAME. rows in Page Designer.</li>
                <li>Create a region of type <strong>Classic Report</strong>. Set its source to <strong>SQL Query</strong> and paste the SQL below.</li>
                <li>Set <strong>Page Items to Submit</strong> to <code>&P11_ITEMS_TO_SUBMIT.</code></li>
                <li>Add a <strong>Server-side Condition</strong>: Item is NOT NULL, <code>&P11_FIRST_ITEM.</code>, so the region hides while a new row is being created.</li>
                </ol>
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P11_SQL
        }
    )

    region apexlang-region (
        name: APEXlang Region
        type: staticContent
        source {
            htmlCode: <p class="ua-steps">For apps kept as APEXlang source: paste this block inside the page's <code>page ( ... )</code> in its <code>.apx</code> file, before the closing parenthesis. On a modal dialog page, change <code>slot: body</code> to <code>slot: contentBody</code>.</p>
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P11_APX
        }
    )

    region audit-history-plugin (
        name: Audit History Plugin
        type: staticContent
        source {
            htmlCode:
                ```html
                <ol class="ua-steps">
                <li>Once per app, add the plugin. App Builder: Shared Components, Plug-ins, Import <code>export/region_type_plugin_util_audit_history.sql</code>. APEXlang: copy the folder <code>shared-components/plugins/region/utilAuditHistory</code> from the Util Audit app.</li>
                <li>Add a region of type <strong>Audit History [Plug-in]</strong>. Set <strong>Table</strong> to <code>&P11_TABLE_NAME.</code> and <strong>Key Items</strong> to <code>&P11_ITEMS_TO_SUBMIT.</code>.</li>
                <li>Or, in an APEXlang app, paste this block into the page's <code>.apx</code> file.</li>
                </ol>
                ```
        }
        layout {
            sequence: 45
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P11_PLUGIN_APX
        }
    )

    region preview (
        name: Preview
        type: staticContent
        source {
            htmlCode: <p class="ua-muted">What the region shows for a row that already has audit events.</p>
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P11_SQL
        }
    )

    region preview-result (
        name: Preview Result
        type: dynamicContent
        source {
            language: plsql
            plsqlFunctionBody:
                ```plsql
                -- Runs the generated query for the chosen key and draws it as a
                -- table. The query binds :SAMPLE_KEY, a PK_VALUE_VC value.
                declare
                    l_sql   clob;
                    l_cur   integer;
                    l_cols  integer;
                    l_desc  dbms_sql.desc_tab2;
                    l_val   varchar2(4000);
                    l_out   clob;
                    l_rows  pls_integer := 0;
                begin
                    if :P11_TABLE_NAME is null or :P11_SAMPLE_KEY is null then
                        return '<p class="ua-muted">Pick a key to see what the region will show.</p>';
                    end if;
                    l_sql := util_audit_query.get_preview_query(
                                 p_table_name     => :P11_TABLE_NAME,
                                 p_style          => :P11_STYLE,
                                 p_columns        => replace(:P11_COLUMNS, ':', ','),
                                 p_child_tables   => replace(:P11_CHILD_TABLES, ':', ','),
                                 p_friendly_names => nvl(:P11_FRIENDLY, 'N'));
                    l_cur := dbms_sql.open_cursor;
                    dbms_sql.parse(l_cur, l_sql, dbms_sql.native);
                    dbms_sql.bind_variable(l_cur, 'SAMPLE_KEY', :P11_SAMPLE_KEY);
                    dbms_sql.describe_columns2(l_cur, l_cols, l_desc);
                    for i in 1 .. l_cols loop
                        dbms_sql.define_column(l_cur, i, l_val, 4000);
                    end loop;
                    l_out := '<table class="t-Report-report"><thead><tr>';
                    for i in 1 .. l_cols loop
                        l_out := l_out || '<th class="t-Report-colHead">' || apex_escape.html(
                                     case l_desc(i).col_name
                                         when 'CHANGED_AT' then 'Changed'
                                         when 'CHANGED_BY' then 'By'
                                         when 'RECORD_KEY' then 'Record'
                                         when 'TABLE_NAME' then 'Table'
                                         else initcap(replace(l_desc(i).col_name, '_', ' '))
                                     end) || '</th>';
                    end loop;
                    l_out := l_out || '</tr></thead><tbody>';
                    l_rows := dbms_sql.execute(l_cur);
                    l_rows := 0;
                    while l_rows < 50 and dbms_sql.fetch_rows(l_cur) > 0 loop
                        l_rows := l_rows + 1;
                        l_out := l_out || '<tr>';
                        for i in 1 .. l_cols loop
                            dbms_sql.column_value(l_cur, i, l_val);
                            if length(l_val) > 200 then
                                l_val := substr(l_val, 1, 200) || '...';
                            end if;
                            l_out := l_out || '<td class="t-Report-cell">' || apex_escape.html(l_val) || '</td>';
                        end loop;
                        l_out := l_out || '</tr>';
                    end loop;
                    dbms_sql.close_cursor(l_cur);
                    if l_rows = 0 then
                        return '<p class="ua-muted">No changes recorded for this row.</p>';
                    end if;
                    return l_out || '</tbody></table><p class="ua-muted">' || l_rows || ' row(s)' ||
                           case when l_rows = 50 then ', first 50 shown' end || '.</p>';
                exception
                    when others then
                        if dbms_sql.is_open(l_cur) then
                            dbms_sql.close_cursor(l_cur);
                        end if;
                        return '<p>' || apex_escape.html(sqlerrm) || '</p>';
                end;
                ```
            pageItemsToSubmit: [
                P11_SAMPLE_KEY
            ]
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P11_SQL
        }
    )

    pageItem P11_TABLE_NAME (
        type: selectList
        label {
            label: Table
            alignment: left
        }
        layout {
            sequence: 10
            region: @settings
            slot: regionBody
            alignment: left
            columnSpan: 4
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select table_name d,
                       table_name r
                  from v_util_audit_tables
                 where trigger_name is not null
                 order by 1
                ```
            displayExtraValues: false
            displayNullValue: true
            nullDisplayValue: - Select an audited table -
        }
        help {
            helpText: The audited table your page shows or edits.
        }
    )

    pageItem P11_PAGE_ID (
        type: numberField
        label {
            label: Page number in your app
            alignment: left
        }
        layout {
            sequence: 20
            region: @settings
            slot: regionBody
            startNewRow: false
            alignment: left
            columnSpan: 4
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Used to name the key items P<page>_<key column>, for example P10_EMP_ID.
        }
    )

    pageItem P11_KEY_ITEMS (
        type: textField
        label {
            label: Key page items
            alignment: left
        }
        layout {
            sequence: 30
            region: @settings
            slot: regionBody
            startNewRow: false
            alignment: left
            columnSpan: 4
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            valuePlaceholder: P10_EMP_ID
        }
        help {
            helpText: Only if your items are not named P<page>_<key column>. Give one item per key column, comma-separated, in key column order.
        }
    )


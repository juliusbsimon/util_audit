            region: @settings
            slot: regionBody
            alignment: left
            columnSpan: 4
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: COLUMNS
        }
    )

    pageItem P11_FRIENDLY (
        type: switch
        label {
            label: Readable column names
            alignment: left
        }
        layout {
            sequence: 50
            region: @settings
            slot: regionBody
            startNewRow: false
            alignment: left
            columnSpan: 4
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: Y

        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct child_table d,
                       child_table r
                  from v_util_audit_child_tables
                 where parent_table = :P11_TABLE_NAME
                   and child_audited = 'Y'
                 order by 1
                ```
        }
        cascadingLov {
            parentItems: [
                P11_TABLE_NAME
            ]
            parentRequired: true
        }
        layout {
            sequence: 80
            region: @settings
            slot: regionBody
            startNewRow: false
            alignment: left
            columnSpan: 4
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        multipleValues {
            type: delimitedList
            separator: :

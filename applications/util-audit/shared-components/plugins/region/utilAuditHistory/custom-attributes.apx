customAttribute attribute_01 (
    apexlangName: table
    attribute: 1
    name: Table
    type: text
    validation {
        required: true
    }
    appearance {
        sequence: 10
    }
    help {
        helpText: The audited table the page shows, for example EMP.
    }
)

customAttribute attribute_02 (
    apexlangName: keyItems
    attribute: 2
    name: Key Items
    type: pageItems
    validation {
        required: true
    }
    appearance {
        sequence: 20
    }
    help {
        helpText: The page items holding the row's primary key, one per key column, in key column order.
    }
)

customAttribute attribute_03 (
    apexlangName: display
    attribute: 3
    name: Display
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 30
    }
    default {
        value: COLUMNS
    }
    help {
        helpText: One row per changed column with old and new values, or one row per change listing the columns that changed.
    }

    entry columns (
        sequence: 10
        display: One row per changed column
        return: COLUMNS
    )

    entry events (
        sequence: 20
        display: One row per change
        return: EVENTS
    )

)

customAttribute attribute_04 (
    apexlangName: childTables
    attribute: 4
    name: Child Tables
    type: text
    validation {
        required: false
    }
    appearance {
        sequence: 40
    }
    help {
        helpText: Audited tables that point at this one, comma-separated, whose changes should also show. For example EMP_TASK,PROJECT.
    }
)

customAttribute attribute_05 (
    apexlangName: columns
    attribute: 5
    name: Columns
    type: text
    validation {
        required: false
    }
    appearance {
        sequence: 50
    }
    help {
        helpText: Only show changes to these columns, comma-separated. Leave empty for all.
    }
)

customAttribute attribute_06 (
    apexlangName: readableNames
    attribute: 6
    name: Readable Column Names
    type: yesNo
    appearance {
        sequence: 60
    }
    default {
        value: true
    }
    help {
        helpText: Show "Hire Date" instead of HIRE_DATE.
    }
)

customAttribute attribute_07 (
    apexlangName: maxRows
    attribute: 7
    name: Maximum Lines
    type: integer
    validation {
        required: true
    }
    appearance {
        sequence: 70
    }
    default {
        value: 100
    }
    help {
        helpText: The most lines to show, newest first.
    }
)

customAttribute attribute_08 (
    apexlangName: dateFormat
    attribute: 8
    name: Date Format
    type: text
    validation {
        required: false
    }
    appearance {
        sequence: 80
    }
    default {
        value: SINCE
    }
    help {
        helpText: SINCE shows "5 minutes ago", with the exact time on hover. Any Oracle date format also works, for example DD-MON-YYYY HH24:MI.
    }
)

customAttribute attribute_09 (
    apexlangName: utilAuditSchema
    attribute: 9
    name: util_audit Schema
    type: text
    validation {
        required: false
    }
    appearance {
        sequence: 90
    }
    help {
        helpText: Only when util_audit is installed in a different schema than the app's. That schema must grant EXECUTE on UTIL_AUDIT_QUERY to the app's schema.
    }
)

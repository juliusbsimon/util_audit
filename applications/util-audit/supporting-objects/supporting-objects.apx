supportingObject (
    installationMessages {
        welcome: Installs the util_audit framework (tables, views and packages) into the application's parsing schema.
        installSuccess: util_audit is installed. Open the app and go to Tables to start auditing.
    }
    upgrade {
        upgradeWhenSqlQuery:
            ```sql
            select 1 from user_objects where object_name = 'UTIL_AUDIT' and object_type = 'PACKAGE'
            ```
    }
    upgradeMessages {
        success: util_audit is upgraded. Go to Maintenance and re-create all triggers so existing tables use the new trigger code.
    }
    deinstall {
        scriptFile: deinstall-script.sql
    }
    deinstallationMessages {
        confirmation: This drops the audit triggers, packages, views and tables, including all audit history.
    }
    advanced {
        includeInAppExport: true
    }

    installScript install-tables (
        execution {
            sequence: 10
        }
        script {
            content:
                ```
                -- Tables and indexes (generated from setup.sql by tools/sync_supporting_objects.py)
                -- util_audit v1 guard
                DECLARE
                    l_v1 NUMBER;
                BEGIN
                    SELECT COUNT(*)
                      INTO l_v1
                      FROM user_tables t
                     WHERE t.table_name = 'UTIL_AUDIT_RECORDS'
                       AND NOT EXISTS (SELECT 1 FROM user_tab_columns c
                                        WHERE c.table_name = t.table_name
                                          AND c.column_name = 'PK_VALUE_VC');
                    IF l_v1 > 0 THEN
                        RAISE_APPLICATION_ERROR(-20100,
                            'This schema has util_audit v1 (UTIL_AUDIT_RECORDS without PK_VALUE_VC). ' ||
                            'Installing over it would break the v1 audit triggers, so nothing was changed. ' ||
                            'Run migrate_v1.sql instead (see docs/migrating-from-v1.md).');
                    END IF;
                END;
                /
                DECLARE
                    PROCEDURE ddl(p_sql IN VARCHAR2) IS
                    BEGIN
                        EXECUTE IMMEDIATE p_sql;
                    EXCEPTION
                        WHEN OTHERS THEN
                            -- ORA-00955: name already used, ORA-01408: column list already indexed,
                            -- ORA-01430: column already exists
                            IF SQLCODE NOT IN (-955, -1408, -1430) THEN
                                RAISE;
                            END IF;
                    END;
                BEGIN
                    ddl(q'[
                create table UTIL_AUDIT_CONFIG
                (
                    TABLE_NAME   VARCHAR2(255) not null
                        primary key,
                    ENABLED_FLAG CHAR
                        check (enabled_flag IN ('Y', 'N')),
                    CREATED_ON   DATE default SYSDATE,
                    CREATED_BY   VARCHAR2(100)
                )]');

                    -- Per-table columns the trigger skips (comma-separated), added in v2.2
                    ddl(q'[alter table UTIL_AUDIT_CONFIG add (IGNORED_COLUMNS VARCHAR2(4000))]');

                    -- Per-table columns never recorded at all, not even in the row
                    -- snapshots: passwords, tokens and other secrets (comma-separated)
                    ddl(q'[alter table UTIL_AUDIT_CONFIG add (EXCLUDED_COLUMNS VARCHAR2(4000))]');

                    ddl(q'[
                create table UTIL_AUDIT_TXN
                (
                    AUDIT_TXN_ID      NUMBER generated by default on null as identity
                        constraint UTIL_AUDIT_TXN_PK
                            primary key,
                    TRANSACTION_ID    VARCHAR2(64)  not null
                        constraint UTIL_AUDIT_TXN_UK
                            unique,
                    DB_TRANSACTION_ID VARCHAR2(100),
                    TABLE_NAME        VARCHAR2(255) not null,
                    PK_VALUE_VC       VARCHAR2(4000),
                    TRANSACTION_TYPE  VARCHAR2(6)   not null
                        constraint UTIL_AUDIT_TXN_TRX_CHK
                            check (transaction_type IN ('INSERT', 'UPDATE', 'DELETE')),
                    USERNAME          VARCHAR2(255),
                    AUDIT_CONTEXT     CLOB
                        check (audit_context IS JSON),
                    OLD_ROW_JSON      CLOB
                        check (old_row_json IS JSON),
                    NEW_ROW_JSON      CLOB
                        check (new_row_json IS JSON),
                    AUDIT_TS          TIMESTAMP(6) default SYSTIMESTAMP not null
                )]');

                    ddl(q'[
                create table UTIL_AUDIT_RECORDS
                (
                    UTIL_AUDIT_RECORD_ID NUMBER generated by default on null as identity
                        constraint UTIL_AUDIT_RECORDS_PK
                            primary key,
                    TRANSACTION_ID       VARCHAR2(64)
                        constraint UTIL_AUDIT_RECORDS_TXN_FK
                            references UTIL_AUDIT_TXN (TRANSACTION_ID),
                    TABLE_NAME           VARCHAR2(255) not null,
                    PK_VALUE_VC          VARCHAR2(4000),
                    COLUMN_NAME          VARCHAR2(255),
                    DATA_TYPE            VARCHAR2(128),
                    TRANSACTION_TYPE     VARCHAR2(6)
                        constraint UTIL_AUDIT_RECORDS_TRX_CHK
                            check (transaction_type IN ('INSERT', 'UPDATE', 'DELETE')),
                    USERNAME             VARCHAR2(255),
                    OLD_VALUE            VARCHAR2(4000),
                    NEW_VALUE            VARCHAR2(4000),
                    OLD_CLOB             CLOB,
                    NEW_CLOB             CLOB,
                    CHANGE_HASH          VARCHAR2(64),
                    AUDIT_TS             TIMESTAMP(6) default SYSTIMESTAMP not null
                )]');

                    -- Audit failures are logged here instead of breaking business DML
                    ddl(q'[
                create table UTIL_AUDIT_ERRORS
                (
                    UTIL_AUDIT_ERROR_ID NUMBER generated by default on null as identity
                        constraint UTIL_AUDIT_ERRORS_PK
                            primary key,
                    ERROR_TS            TIMESTAMP(6) default SYSTIMESTAMP not null,
                    TABLE_NAME          VARCHAR2(255),
                    TRANSACTION_TYPE    VARCHAR2(6),
                    PK_VALUE_VC         VARCHAR2(4000),
                    USERNAME            VARCHAR2(255),
                    ERROR_CODE          NUMBER,
                    ERROR_MESSAGE       VARCHAR2(4000),
                    ERROR_BACKTRACE     VARCHAR2(4000)
                )]');

                    ddl(q'[create index UTIL_AUDIT_RECORDS_HIST_IX
                    on UTIL_AUDIT_RECORDS (TABLE_NAME asc, PK_VALUE_VC asc, AUDIT_TS desc)]');

                    ddl(q'[create index UTIL_AUDIT_RECORDS_TBL_TS_IX
                    on UTIL_AUDIT_RECORDS (TABLE_NAME asc, AUDIT_TS desc)]');

                    -- Settings, e.g. for archiving (name/value pairs)
                    ddl(q'[
                create table UTIL_AUDIT_SETTINGS
                (
                    NAME       VARCHAR2(100) not null
                        constraint UTIL_AUDIT_SETTINGS_PK
                            primary key,
                    VALUE      VARCHAR2(4000),
                    UPDATED_ON DATE default SYSDATE,
                    UPDATED_BY VARCHAR2(255)
                )]');

                    -- One row per archive file: one table, one month of events
                    ddl(q'[
                create table UTIL_AUDIT_ARCHIVE_FILES
                (
                    ARCHIVE_ID   NUMBER generated by default on null as identity
                        constraint UTIL_AUDIT_ARCHIVE_FILES_PK
                            primary key,
                    TABLE_NAME   VARCHAR2(255) not null,
                    PERIOD_START TIMESTAMP(6)  not null,
                    PERIOD_END   TIMESTAMP(6)  not null,
                    EVENT_COUNT  NUMBER,
                    RECORD_COUNT NUMBER,
                    FILE_NAME    VARCHAR2(1000),
                    FILE_BYTES   NUMBER,
                    FILE_SHA256  VARCHAR2(80),
                    STORAGE      VARCHAR2(20),
                    LOCATION     VARCHAR2(1000),
                    STATUS       VARCHAR2(20) not null
                        constraint UTIL_AUDIT_ARCHIVE_FILES_ST_CHK
                            check (status IN ('CREATED', 'STORED', 'PURGED', 'RESTORED', 'FAILED')),
                    CONTENT      BLOB,
                    MESSAGE      VARCHAR2(4000),
                    CREATED_ON   TIMESTAMP(6) default SYSTIMESTAMP not null,
                    CREATED_BY   VARCHAR2(255),
                    STORED_ON    TIMESTAMP(6),
                    PURGED_ON    TIMESTAMP(6),
                    RESTORED_ON  TIMESTAMP(6)
                )]');

                    ddl(q'[create index UTIL_AUDIT_ARCHIVE_FILES_IX
                    on UTIL_AUDIT_ARCHIVE_FILES (TABLE_NAME, PERIOD_START)]');

                    -- Restore looks up the other events of the same database transaction
                    ddl(q'[create index UTIL_AUDIT_TXN_DBTXN_IX
                    on UTIL_AUDIT_TXN (DB_TRANSACTION_ID asc, TABLE_NAME asc)]');

                    ddl(q'[create index UTIL_AUDIT_RECORDS_HASH_IX
                    on UTIL_AUDIT_RECORDS (CHANGE_HASH)]');

                    -- FK column: used by the views' joins and by purges of UTIL_AUDIT_TXN
                    ddl(q'[create index UTIL_AUDIT_RECORDS_TXN_IX
                    on UTIL_AUDIT_RECORDS (TRANSACTION_ID)]');

                    ddl(q'[create index UTIL_AUDIT_TXN_HIST_IX
                    on UTIL_AUDIT_TXN (TABLE_NAME asc, PK_VALUE_VC asc, AUDIT_TS desc)]');

                    ddl(q'[create index UTIL_AUDIT_TXN_TBL_TS_IX
                    on UTIL_AUDIT_TXN (TABLE_NAME asc, AUDIT_TS desc)]');

                    ddl(q'[create index UTIL_AUDIT_ERRORS_TS_IX
                    on UTIL_AUDIT_ERRORS (ERROR_TS desc)]');
                END;
                /
                ```
        }
    )

    installScript install-views (
        execution {
            sequence: 20
        }
        script {
            content:
                ```
                -- Views (generated from setup.sql by tools/sync_supporting_objects.py)
                -- util_audit v1 guard
                DECLARE
                    l_v1 NUMBER;
                BEGIN
                    SELECT COUNT(*)
                      INTO l_v1
                      FROM user_tables t
                     WHERE t.table_name = 'UTIL_AUDIT_RECORDS'
                       AND NOT EXISTS (SELECT 1 FROM user_tab_columns c
                                        WHERE c.table_name = t.table_name
                                          AND c.column_name = 'PK_VALUE_VC');
                    IF l_v1 > 0 THEN
                        RAISE_APPLICATION_ERROR(-20100,
                            'This schema has util_audit v1 (UTIL_AUDIT_RECORDS without PK_VALUE_VC). ' ||
                            'Installing over it would break the v1 audit triggers, so nothing was changed. ' ||
                            'Run migrate_v1.sql instead (see docs/migrating-from-v1.md).');
                    END IF;
                END;
                /
                -- The util_audit trigger of each table: any trigger that calls the
                -- UTIL_AUDIT package. Found by dependency, not by name, so other teams'
                -- triggers named AUD_<table> are never mistaken for ours.
                create or replace view V_UTIL_AUDIT_TRIGGERS as
                SELECT
                    t.table_name,
                    t.trigger_name,
                    t.status,
                    o.status object_status
                FROM user_triggers t
                JOIN user_objects o
                  ON o.object_name = t.trigger_name
                 AND o.object_type = 'TRIGGER'
                WHERE t.base_object_type = 'TABLE'
                  AND EXISTS (SELECT 1
                              FROM user_dependencies d
                              WHERE d.name            = t.trigger_name
                                AND d.type            = 'TRIGGER'
                                AND d.referenced_name = 'UTIL_AUDIT'
                                AND d.referenced_type = 'PACKAGE')
                /
                -- Foreign keys between tables in this schema, and whether each child table
                -- has an audit trigger. util_audit.restore_row can only bring back child
                -- rows from audited child tables.
                create or replace view V_UTIL_AUDIT_CHILD_TABLES as
                SELECT
                    p.table_name       parent_table,
                    c.table_name       child_table,
                    c.constraint_name,
                    c.delete_rule,
                    CASE WHEN EXISTS (SELECT 1
                                      FROM v_util_audit_triggers t
                                      WHERE t.table_name = c.table_name)
                         THEN 'Y' ELSE 'N' END child_audited
                FROM user_constraints c
                JOIN user_constraints p
                  ON p.constraint_name = c.r_constraint_name
                 AND p.owner           = c.r_owner
                WHERE c.constraint_type = 'R'
                /
                -- Every table in the schema with its audit status
                create or replace view V_UTIL_AUDIT_TABLES as
                SELECT
                    t.table_name,
                    CASE
                        WHEN tr.trigger_name IS NULL        THEN 'Not audited'
                        WHEN tr.object_status <> 'VALID'    THEN 'Trigger invalid'
                        WHEN tr.status <> 'ENABLED'         THEN 'Trigger disabled'
                        WHEN NVL(c.enabled_flag, 'N') = 'Y' THEN 'Auditing'
                        ELSE 'Paused'
                    END                                  audit_status,
                    tr.trigger_name,
                    NVL(c.enabled_flag, 'N')             enabled_flag,
                    c.ignored_columns,
                    c.excluded_columns,
                    CASE WHEN EXISTS (SELECT 1 FROM user_constraints k
                                      WHERE k.table_name = t.table_name
                                        AND k.constraint_type = 'P')
                         THEN 'Y' ELSE 'N' END           has_pk,
                    (SELECT COUNT(*) FROM v_util_audit_child_tables ch
                     WHERE ch.parent_table = t.table_name)                 child_tables,
                    (SELECT COUNT(*) FROM v_util_audit_child_tables ch
                     WHERE ch.parent_table = t.table_name
                       AND ch.child_audited = 'N')                         unaudited_child_tables,
                    (SELECT COUNT(*) FROM util_audit_txn x
                     WHERE x.table_name = t.table_name)                    event_count,
                    (SELECT MAX(x.audit_ts) FROM util_audit_txn x
                     WHERE x.table_name = t.table_name)                    last_event_ts
                FROM user_tables t
                LEFT JOIN (SELECT table_name,
                                  MIN(trigger_name)  trigger_name,
                                  MIN(status)        status,
                                  MIN(object_status) object_status
                           FROM v_util_audit_triggers
                           GROUP BY table_name) tr
                  ON tr.table_name = t.table_name
                LEFT JOIN util_audit_config c
                  ON c.table_name = t.table_name
                WHERE t.table_name NOT LIKE 'UTIL\_AUDIT\_%' ESCAPE '\'
                  AND t.dropped = 'NO'
                /
                create or replace view V_UTIL_AUDIT_EVENTS as
                SELECT
                    t.audit_ts,
                    t.table_name,
                    t.pk_value_vc,
                    t.transaction_type,
                    t.username,
                    t.transaction_id,
                    t.db_transaction_id,
                    t.audit_context,
                    t.old_row_json,
                    t.new_row_json
                FROM util_audit_txn t
                /
                create or replace view V_UTIL_AUDIT_CHANGES as
                SELECT
                    r.audit_ts,
                    r.table_name,
                    r.pk_value_vc,
                    r.transaction_type,
                    r.username,
                    r.transaction_id,
                    r.column_name,
                    r.data_type,
                    r.old_value,
                    r.new_value,
                    r.old_clob,
                    r.new_clob,
                    r.change_hash
                FROM util_audit_records r
                /
                create or replace view V_UTIL_AUDIT_ROW_HISTORY as
                SELECT
                    e.audit_ts,
                    e.table_name,
                    e.pk_value_vc,
                    e.transaction_type,
                    e.username,
                    e.transaction_id,
                    e.db_transaction_id,
                    c.column_name,
                    c.data_type,
                    c.old_value,
                    c.new_value,
                    c.old_clob,
                    c.new_clob,
                    e.audit_context,
                    e.old_row_json,
                    e.new_row_json
                FROM v_util_audit_events  e
                LEFT JOIN v_util_audit_changes c
                  ON c.transaction_id = e.transaction_id
                /
                create or replace view V_UTIL_AUDIT_LATEST_BY_ROW as
                SELECT "AUDIT_TS","TABLE_NAME","PK_VALUE_VC","TRANSACTION_TYPE","USERNAME","TRANSACTION_ID","DB_TRANSACTION_ID","AUDIT_CONTEXT","OLD_ROW_JSON","NEW_ROW_JSON","RN"
                FROM (
                    SELECT
                        e.*,
                        ROW_NUMBER() OVER (
                            PARTITION BY e.table_name, e.pk_value_vc
                            ORDER BY e.audit_ts DESC
                        ) rn
                    FROM v_util_audit_events e
                )
                WHERE rn = 1
                /
                create or replace view V_UTIL_AUDIT_EVENT_SUMMARY as
                SELECT
                    e.audit_ts,
                    e.table_name,
                    e.pk_value_vc,
                    e.transaction_type,
                    e.username,
                    e.transaction_id,
                    LISTAGG(c.column_name, ', ' ON OVERFLOW TRUNCATE '...' WITH COUNT)
                        WITHIN GROUP (ORDER BY c.column_name) AS changed_columns
                FROM v_util_audit_events e
                LEFT JOIN v_util_audit_changes c
                  ON c.transaction_id = e.transaction_id
                GROUP BY
                    e.audit_ts, e.table_name, e.pk_value_vc, e.transaction_type, e.username, e.transaction_id
                /
                ```
        }
    )

    installScript install-util-audit-spec (
        execution {
            sequence: 30
        }
        script {
            content:
                ```
                -- Package util_audit (generated from setup.sql by tools/sync_supporting_objects.py)
                -- util_audit v1 guard
                DECLARE
                    l_v1 NUMBER;
                BEGIN
                    SELECT COUNT(*)
                      INTO l_v1
                      FROM user_tables t
                     WHERE t.table_name = 'UTIL_AUDIT_RECORDS'
                       AND NOT EXISTS (SELECT 1 FROM user_tab_columns c
                                        WHERE c.table_name = t.table_name
                                          AND c.column_name = 'PK_VALUE_VC');
                    IF l_v1 > 0 THEN
                        RAISE_APPLICATION_ERROR(-20100,
                            'This schema has util_audit v1 (UTIL_AUDIT_RECORDS without PK_VALUE_VC). ' ||
                            'Installing over it would break the v1 audit triggers, so nothing was changed. ' ||
                            'Run migrate_v1.sql instead (see docs/migrating-from-v1.md).');
                    END IF;
                END;
                /
                create or replace PACKAGE util_audit AS
                    ------------------------------------------------------------------------------
                    --  PURPOSE
                    --      Centralized auditing framework (v2)
                    --
                    --  FEATURES
                    --      • Generic PK support
                    --      • JSON context capture
                    --      • DB transaction grouping
                    --      • Change hashing
                    --      • Config-driven enablement
                    ------------------------------------------------------------------------------

                    ------------------------------------------------------------------------------
                    -- CONFIG MANAGEMENT
                    ------------------------------------------------------------------------------

                    PROCEDURE enable_table (
                        p_table_name IN VARCHAR2
                    );

                    PROCEDURE disable_table (
                        p_table_name IN VARCHAR2
                    );

                    FUNCTION table_enabled (
                        p_table_name IN VARCHAR2
                    ) RETURN BOOLEAN;

                    FUNCTION table_enabled_sql (
                        p_table_name IN VARCHAR2
                    ) RETURN VARCHAR2;

                    ------------------------------------------------------------------------------
                    -- CONTEXT
                    ------------------------------------------------------------------------------

                    FUNCTION get_audit_context
                        RETURN CLOB;

                    ------------------------------------------------------------------------------
                    -- CAPTURE (called by triggers)
                    ------------------------------------------------------------------------------

                    PROCEDURE capture_audit (
                        p_transaction_json IN json_object_t
                    );

                    -- Records an audit failure in UTIL_AUDIT_ERRORS (autonomous transaction).
                    -- Never raises.
                    PROCEDURE log_error (
                        p_table_name       IN VARCHAR2,
                        p_transaction_type IN VARCHAR2,
                        p_pk_value         IN VARCHAR2,
                        p_error_code       IN NUMBER,
                        p_error_message    IN VARCHAR2,
                        p_error_backtrace  IN VARCHAR2
                    );

                    ------------------------------------------------------------------------------
                    -- PURGE
                    ------------------------------------------------------------------------------

                    -- Deletes audit events (and their column changes) older than p_before.
                    -- p_table_name limits the purge to one table. Does not commit.
                    PROCEDURE purge (
                        p_before         IN  TIMESTAMP,
                        p_table_name     IN  VARCHAR2 DEFAULT NULL,
                        p_events_deleted OUT NUMBER
                    );

                    -- Deletes logged audit errors older than p_before. Does not commit.
                    PROCEDURE purge_errors (
                        p_before         IN  TIMESTAMP,
                        p_errors_deleted OUT NUMBER
                    );

                    ------------------------------------------------------------------------------
                    -- RESTORE
                    ------------------------------------------------------------------------------

                    -- Puts a row back the way it was just before one audited event.
                    --   DELETE event: re-inserts the row.
                    --   UPDATE event: sets the row's columns back to their old values.
                    --   INSERT events cannot be restored.
                    --
                    -- p_include_children: also restore child rows (found through foreign keys)
                    --     that were deleted, or had their FK set to NULL, in the same database
                    --     transaction as a restored DELETE. Grandchildren are included.
                    -- p_force:   restore even when the row has later audit events, which
                    --            overwrites those later changes.
                    -- p_preview: do the full restore, print what happened, then roll it back.
                    --
                    -- Does not commit. Prints each step with DBMS_OUTPUT. On error, everything
                    -- this call changed is rolled back.
                    PROCEDURE restore_row (
                        p_transaction_id   IN VARCHAR2,
                        p_include_children IN BOOLEAN DEFAULT TRUE,
                        p_force            IN BOOLEAN DEFAULT FALSE,
                        p_preview          IN BOOLEAN DEFAULT FALSE
                    );

                END util_audit;
                /
                ```
        }
    )

    installScript install-util-audit-restore-spec (
        execution {
            sequence: 40
        }
        script {
            content:
                ```
                -- Package util_audit_restore (generated from setup.sql by tools/sync_supporting_objects.py)
                -- util_audit v1 guard
                DECLARE
                    l_v1 NUMBER;
                BEGIN
                    SELECT COUNT(*)
                      INTO l_v1
                      FROM user_tables t
                     WHERE t.table_name = 'UTIL_AUDIT_RECORDS'
                       AND NOT EXISTS (SELECT 1 FROM user_tab_columns c
                                        WHERE c.table_name = t.table_name
                                          AND c.column_name = 'PK_VALUE_VC');
                    IF l_v1 > 0 THEN
                        RAISE_APPLICATION_ERROR(-20100,
                            'This schema has util_audit v1 (UTIL_AUDIT_RECORDS without PK_VALUE_VC). ' ||
                            'Installing over it would break the v1 audit triggers, so nothing was changed. ' ||
                            'Run migrate_v1.sql instead (see docs/migrating-from-v1.md).');
                    END IF;
                END;
                /
                create or replace PACKAGE util_audit_restore AS
                    ------------------------------------------------------------------------------
                    -- util_audit_restore
                    --
                    -- The work behind util_audit.restore_row; call that instead. A separate
                    -- package so each package body fits in one APEX supporting-objects script.
                    ------------------------------------------------------------------------------

                    PROCEDURE restore_row (
                        p_transaction_id   IN VARCHAR2,
                        p_include_children IN BOOLEAN DEFAULT TRUE,
                        p_force            IN BOOLEAN DEFAULT FALSE,
                        p_preview          IN BOOLEAN DEFAULT FALSE
                    );

                END util_audit_restore;
                /
                ```
        }
    )

    installScript install-util-audit-restore-body (
        execution {
            sequence: 50
        }
        script {
            content:
                ```
                -- Package body util_audit_restore (generated from setup.sql by tools/sync_supporting_objects.py)
                -- util_audit v1 guard
                DECLARE
                    l_v1 NUMBER;
                BEGIN
                    SELECT COUNT(*)
                      INTO l_v1
                      FROM user_tables t
                     WHERE t.table_name = 'UTIL_AUDIT_RECORDS'
                       AND NOT EXISTS (SELECT 1 FROM user_tab_columns c
                                        WHERE c.table_name = t.table_name
                                          AND c.column_name = 'PK_VALUE_VC');
                    IF l_v1 > 0 THEN
                        RAISE_APPLICATION_ERROR(-20100,
                            'This schema has util_audit v1 (UTIL_AUDIT_RECORDS without PK_VALUE_VC). ' ||
                            'Installing over it would break the v1 audit triggers, so nothing was changed. ' ||
                            'Run migrate_v1.sql instead (see docs/migrating-from-v1.md).');
                    END IF;
                END;
                /
                create or replace PACKAGE BODY util_audit_restore AS

                    TYPE t_names IS TABLE OF VARCHAR2(128) INDEX BY PLS_INTEGER;
                    TYPE t_seen  IS TABLE OF BOOLEAN INDEX BY VARCHAR2(64);

                    -- Child events that had to wait for another parent row (restore_row)
                    g_pending t_names;

                    FUNCTION q(p_name IN VARCHAR2) RETURN VARCHAR2 IS
                    BEGIN
                        RETURN '"' || p_name || '"';
                    END;

                    FUNCTION pk_columns(p_table_name IN VARCHAR2) RETURN t_names IS
                        l_cols t_names;
                    BEGIN
                        SELECT cols.column_name
                        BULK COLLECT INTO l_cols
                        FROM user_constraints cons
                        JOIN user_cons_columns cols
                          ON cols.constraint_name = cons.constraint_name
                        WHERE cons.table_name = p_table_name
                          AND cons.constraint_type = 'P'
                        ORDER BY cols.position;
                        RETURN l_cols;
                    END;

                    -- PK value in the same format the trigger writes to PK_VALUE_VC
                    FUNCTION pk_string(p_table_name IN VARCHAR2, p_row IN json_object_t) RETURN VARCHAR2 IS
                        l_cols t_names := pk_columns(p_table_name);
                        l_obj  json_object_t := json_object_t();
                    BEGIN
                        IF l_cols.COUNT = 1 THEN
                            RETURN p_row.get_string(l_cols(1));
                        END IF;
                        FOR i IN 1 .. l_cols.COUNT LOOP
                            l_obj.put(l_cols(i), p_row.get_string(l_cols(i)));
                        END LOOP;
                        RETURN l_obj.to_string;
                    END;

                    -- SQL expression that turns a stored text value back into the column's
                    -- type. The inverse of util_audit_gen's to_char_expr; NLS-independent.
                    FUNCTION from_text_expr(p_bind IN VARCHAR2, p_data_type IN VARCHAR2) RETURN VARCHAR2 IS
                        v_dt VARCHAR2(128) := UPPER(p_data_type);
                        c_greg CONSTANT VARCHAR2(40) := q'[, 'NLS_CALENDAR=GREGORIAN')]';
                    BEGIN
                        IF v_dt IN ('NUMBER', 'FLOAT') THEN
                            RETURN 'JSON_VALUE(JSON_OBJECT(''v'' VALUE ' || p_bind || '), ''$.v'' RETURNING NUMBER ERROR ON ERROR)';
                        ELSIF v_dt IN ('BINARY_FLOAT', 'BINARY_DOUBLE') THEN
                            RETURN 'JSON_VALUE(JSON_OBJECT(''v'' VALUE ' || p_bind || '), ''$.v'' RETURNING BINARY_DOUBLE ERROR ON ERROR)';
                        ELSIF v_dt = 'RAW' THEN
                            RETURN 'HEXTORAW(' || p_bind || ')';
                        ELSIF v_dt = 'DATE' THEN
                            RETURN 'TO_DATE(' || p_bind || q'[, 'YYYY-MM-DD"T"HH24:MI:SS']' || c_greg;
                        ELSIF v_dt LIKE 'TIMESTAMP% TIME ZONE' THEN
                            RETURN 'TO_TIMESTAMP_TZ(' || p_bind || q'[, 'YYYY-MM-DD"T"HH24:MI:SS.FF TZH:TZM']' || c_greg;
                        ELSIF v_dt LIKE 'TIMESTAMP%' THEN
                            RETURN 'TO_TIMESTAMP(' || p_bind || q'[, 'YYYY-MM-DD"T"HH24:MI:SS.FF']' || c_greg;
                        ELSIF v_dt LIKE 'INTERVAL DAY%' THEN
                            RETURN 'TO_DSINTERVAL(' || p_bind || ')';
                        ELSIF v_dt LIKE 'INTERVAL YEAR%' THEN
                            RETURN 'TO_YMINTERVAL(' || p_bind || ')';
                        ELSE
                            -- character types and CLOB
                            RETURN p_bind;
                        END IF;
                    END;

                    -- Equal as stored text, byte for byte (not affected by NLS_COMP)
                    FUNCTION same(p_a IN VARCHAR2, p_b IN VARCHAR2) RETURN BOOLEAN IS
                    BEGIN
                        RETURN p_a IS NOT NULL AND p_b IS NOT NULL
                           AND UTL_I18N.STRING_TO_RAW(p_a, 'AL32UTF8') = UTL_I18N.STRING_TO_RAW(p_b, 'AL32UTF8');
                    END;

                    PROCEDURE say(p_depth IN PLS_INTEGER, p_text IN VARCHAR2) IS
                    BEGIN
                        DBMS_OUTPUT.PUT_LINE(RPAD(' ', p_depth * 2) || p_text);
                    END;

                    PROCEDURE restore_event(
                        p_txn_id           IN VARCHAR2,
                        p_include_children IN BOOLEAN,
                        p_force            IN BOOLEAN,
                        p_depth            IN PLS_INTEGER,
                        p_seen             IN OUT NOCOPY t_seen
                    );

                    -- Restores child rows that went with a deleted parent row. A child event
                    -- belongs to the parent when it is in the same database transaction and
                    -- its old FK values equal the parent's old key values.
                    PROCEDURE restore_children(
                        p_parent    IN util_audit_txn%ROWTYPE,
                        p_old       IN json_object_t,
                        p_force     IN BOOLEAN,
                        p_depth     IN PLS_INTEGER,
                        p_seen      IN OUT NOCOPY t_seen
                    ) IS
                        l_child_cols  t_names;
                        l_parent_cols t_names;
                        l_child_old   json_object_t;
                        l_child_new   json_object_t;
                        l_match       BOOLEAN;
                        l_fk_nulled   BOOLEAN;
                    BEGIN
                        FOR fk IN (
                            SELECT ch.child_table, ch.constraint_name, ch.delete_rule, ch.child_audited
                            FROM v_util_audit_child_tables ch
                            WHERE ch.parent_table = p_parent.table_name
                            ORDER BY ch.child_table, ch.constraint_name
                        ) LOOP
                            IF fk.child_audited = 'N' THEN
                                say(p_depth + 1, 'WARNING: ' || fk.child_table || ' references ' || p_parent.table_name ||
                                             ' (' || fk.constraint_name || ', ON DELETE ' || fk.delete_rule ||
                                             ') but is not audited. Child rows removed with this row cannot be restored.');
                            END IF;

                            -- Child FK columns paired with the parent key columns they reference
                            SELECT cc.column_name, pc.column_name
                            BULK COLLECT INTO l_child_cols, l_parent_cols
                            FROM user_constraints c
                            JOIN user_cons_columns cc
                              ON cc.constraint_name = c.constraint_name
                            JOIN user_cons_columns pc
                              ON pc.constraint_name = c.r_constraint_name
                             AND pc.position        = cc.position
                            WHERE c.constraint_name = fk.constraint_name
                            ORDER BY cc.position;

                            FOR ev IN (
                                SELECT transaction_id, transaction_type, old_row_json, new_row_json
                                FROM util_audit_txn
                                WHERE table_name        = fk.child_table
                                  AND db_transaction_id = p_parent.db_transaction_id
                                  AND transaction_type IN ('DELETE', 'UPDATE')
                                  AND old_row_json IS NOT NULL
                                ORDER BY audit_ts
                            ) LOOP
                                l_child_old := json_object_t.parse(ev.old_row_json);
                                l_match     := TRUE;
                                l_fk_nulled := TRUE;

                                IF ev.transaction_type = 'UPDATE' THEN
                                    l_child_new := json_object_t.parse(ev.new_row_json);
                                END IF;

                                FOR i IN 1 .. l_child_cols.COUNT LOOP
                                    IF NOT p_old.has(l_parent_cols(i))
                                       OR NOT same(l_child_old.get_string(l_child_cols(i)), p_old.get_string(l_parent_cols(i))) THEN
                                        l_match := FALSE;
                                        EXIT;
                                    END IF;
                                    IF ev.transaction_type = 'UPDATE'
                                       AND l_child_new.get_string(l_child_cols(i)) IS NOT NULL THEN
                                        l_fk_nulled := FALSE;
                                    END IF;
                                END LOOP;

                                -- An UPDATE only belongs to the parent delete if it set the FK
                                -- to NULL (ON DELETE SET NULL). An UPDATE that moved the child
                                -- to another parent is a separate change.
                                IF l_match AND (ev.transaction_type = 'DELETE' OR l_fk_nulled) THEN
                                    restore_event(ev.transaction_id, TRUE, p_force, p_depth + 1, p_seen);
                                END IF;
                            END LOOP;
                        END LOOP;
                    END;

                    PROCEDURE restore_event(
                        p_txn_id           IN VARCHAR2,
                        p_include_children IN BOOLEAN,
                        p_force            IN BOOLEAN,
                        p_depth            IN PLS_INTEGER,
                        p_seen             IN OUT NOCOPY t_seen
                    ) IS
                        e          util_audit_txn%ROWTYPE;
                        l_old      json_object_t;
                        l_new      json_object_t;
                        l_pk_cols  t_names;
                        l_pk_after VARCHAR2(4000);
                        l_later    NUMBER;
                        l_cols     t_names;
                        l_dts      t_names;
                        l_n        PLS_INTEGER := 0;
                        l_list     VARCHAR2(32767);
                        l_vals     VARCHAR2(32767);
                        l_where    VARCHAR2(32767);
                        l_missing  VARCHAR2(4000);
                        l_sql      VARCHAR2(32767);
                        l_cur      INTEGER;
                        l_rows     INTEGER;
                        l_clob     CLOB;
                        l_pk_dt    VARCHAR2(128);
                    BEGIN
                        IF p_seen.EXISTS(p_txn_id) THEN
                            RETURN;
                        END IF;
                        p_seen(p_txn_id) := TRUE;

                        BEGIN
                            SELECT * INTO e FROM util_audit_txn WHERE transaction_id = p_txn_id;
                        EXCEPTION
                            WHEN NO_DATA_FOUND THEN
                                RAISE_APPLICATION_ERROR(-20010, 'Audit event not found: ' || p_txn_id);
                        END;

                        -- The table name comes from audit data, so check it names a table
                        SELECT COUNT(*) INTO l_later FROM user_tables WHERE table_name = e.table_name;
                        IF l_later = 0 THEN
                            RAISE_APPLICATION_ERROR(-20019, 'Table ' || e.table_name || ' of event ' || p_txn_id ||
                                                            ' no longer exists.');
                        END IF;

                        IF e.transaction_type = 'INSERT' THEN
                            RAISE_APPLICATION_ERROR(-20011, 'INSERT events cannot be restored (event ' || p_txn_id || ').');
                        END IF;
                        IF e.old_row_json IS NULL THEN
                            RAISE_APPLICATION_ERROR(-20012, 'Event ' || p_txn_id || ' has no row snapshot. ' ||
                                                            'Events copied from util_audit v1, or recorded before v2.2, cannot be restored.');
                        END IF;

                        l_old := json_object_t.parse(e.old_row_json);

                        -- Where the row stands right after this event, and whether anything
                        -- happened to it since
                        IF e.transaction_type = 'UPDATE' THEN
                            l_new      := json_object_t.parse(e.new_row_json);
                            l_pk_after := pk_string(e.table_name, l_new);
                        ELSE
                            l_pk_after := e.pk_value_vc;
                        END IF;

                        SELECT COUNT(*)
                        INTO l_later
                        FROM util_audit_txn
                        WHERE table_name  = e.table_name
                          AND pk_value_vc = l_pk_after
                          AND audit_ts    > e.audit_ts;

                        IF l_later > 0 AND NOT p_force THEN
                            RAISE_APPLICATION_ERROR(-20013, e.table_name || ' ' || l_pk_after || ' has ' || l_later ||
                                ' later audit event(s). Restoring would overwrite them. Pass p_force => TRUE to do it anyway.');
                        END IF;

                        -- Columns to write: those in the snapshot that can still be written
                        FOR c IN (
                            SELECT tc.column_name, tc.data_type, tc.virtual_column, tc.nullable, tc.default_length,
                                   NVL(ic.generation_type, '-') generation_type
                            FROM user_tab_cols tc
                            LEFT JOIN user_tab_identity_cols ic
                              ON ic.table_name  = tc.table_name
                             AND ic.column_name = tc.column_name
                            WHERE tc.table_name    = e.table_name
                              AND tc.hidden_column = 'NO'
                            ORDER BY tc.column_id
                        ) LOOP
                            IF c.virtual_column = 'YES' THEN
                                CONTINUE;
                            END IF;
                            IF NOT l_old.has(c.column_name) THEN
                                IF e.transaction_type = 'DELETE' THEN
                                    l_pk_cols := pk_columns(e.table_name);
                                    FOR i IN 1 .. l_pk_cols.COUNT LOOP
                                        IF l_pk_cols(i) = c.column_name THEN
                                            RAISE_APPLICATION_ERROR(-20015, 'Key column ' || c.column_name ||
                                                ' is not in the audit snapshot, so the row cannot be re-inserted.');
                                        END IF;
                                    END LOOP;
                                    -- Typically an excluded column (a password, say)
                                    IF c.nullable = 'N' AND NVL(c.default_length, 0) = 0 AND c.generation_type = '-' THEN
                                        RAISE_APPLICATION_ERROR(-20009, e.table_name || '.' || c.column_name ||
                                            ' is not recorded (it is excluded from auditing, or was added later) and is ' ||
                                            'NOT NULL without a default, so the deleted row cannot be re-inserted.');
                                    END IF;
                                END IF;
                                l_missing := l_missing || ', ' || c.column_name;
                                CONTINUE;
                            END IF;
                            IF c.generation_type = 'ALWAYS' THEN
                                IF e.transaction_type = 'DELETE' THEN
                                    RAISE_APPLICATION_ERROR(-20014, e.table_name || '.' || c.column_name ||
                                        ' is GENERATED ALWAYS AS IDENTITY, so the row cannot be re-inserted with its original value.');
                                END IF;
                                CONTINUE;
                            END IF;

                            l_n := l_n + 1;
                            l_cols(l_n) := c.column_name;
                            l_dts(l_n)  := c.data_type;

                            IF e.transaction_type = 'DELETE' THEN
                                l_list := l_list || ', ' || q(c.column_name);
                                l_vals := l_vals || ', ' || from_text_expr(':b' || l_n, c.data_type);
                            ELSE
                                l_list := l_list || ', ' || q(c.column_name) || ' = ' || from_text_expr(':b' || l_n, c.data_type);
                            END IF;
                        END LOOP;

                        IF e.transaction_type = 'DELETE' THEN
                            l_sql := 'INSERT INTO ' || q(e.table_name) || ' (' || SUBSTR(l_list, 3) || ')' ||
                                     ' VALUES (' || SUBSTR(l_vals, 3) || ')';
                        ELSE
                            -- Find the row by its key as it was right after the event
                            l_pk_cols := pk_columns(e.table_name);
                            FOR i IN 1 .. l_pk_cols.COUNT LOOP
                                IF NOT l_new.has(l_pk_cols(i)) THEN
                                    RAISE_APPLICATION_ERROR(-20015, 'Key column ' || l_pk_cols(i) || ' is not in the audit snapshot.');
                                END IF;
                                SELECT data_type
                                INTO l_pk_dt
                                FROM user_tab_columns
                                WHERE table_name  = e.table_name
                                  AND column_name = l_pk_cols(i);
                                l_where := l_where || ' AND ' || q(l_pk_cols(i)) || ' = ' ||
                                           from_text_expr(':k' || i, l_pk_dt);
                            END LOOP;
                            l_sql := 'UPDATE ' || q(e.table_name) || ' SET ' || SUBSTR(l_list, 3) ||
                                     ' WHERE ' || SUBSTR(l_where, 6);
                        END IF;

                        l_cur := DBMS_SQL.OPEN_CURSOR;
                        BEGIN
                            DBMS_SQL.PARSE(l_cur, l_sql, DBMS_SQL.NATIVE);

                            FOR i IN 1 .. l_n LOOP
                                IF l_dts(i) = 'CLOB' THEN
                                    -- JSON null must stay NULL, not become an empty CLOB
                                    l_clob := CASE WHEN NOT l_old.get(l_cols(i)).is_null THEN l_old.get_clob(l_cols(i)) END;
                                    DBMS_SQL.BIND_VARIABLE(l_cur, ':b' || i, l_clob);
                                ELSE
                                    DBMS_SQL.BIND_VARIABLE(l_cur, ':b' || i, l_old.get_string(l_cols(i)), 32767);
                                END IF;
                            END LOOP;

                            IF e.transaction_type = 'UPDATE' THEN
                                FOR i IN 1 .. l_pk_cols.COUNT LOOP
                                    DBMS_SQL.BIND_VARIABLE(l_cur, ':k' || i, l_new.get_string(l_pk_cols(i)), 32767);
                                END LOOP;
                            END IF;

                            l_rows := DBMS_SQL.EXECUTE(l_cur);
                            DBMS_SQL.CLOSE_CURSOR(l_cur);
                        EXCEPTION
                            WHEN OTHERS THEN
                                IF DBMS_SQL.IS_OPEN(l_cur) THEN
                                    DBMS_SQL.CLOSE_CURSOR(l_cur);
                                END IF;
                                IF SQLCODE = -1 THEN
                                    RAISE_APPLICATION_ERROR(-20016, e.table_name || ' ' || l_pk_after ||
                                        ' already exists, so the deleted row cannot be re-inserted.');
                                ELSIF SQLCODE = -2291 AND p_depth > 0 THEN
                                    -- A child row that also references another deleted parent:
                                    -- try again once the other rows are back (see restore_row)
                                    p_seen.DELETE(p_txn_id);
                                    g_pending(g_pending.COUNT + 1) := p_txn_id;
                                    say(p_depth, 'Waiting: ' || e.table_name || ' ' || l_pk_after ||
                                                 ' also needs another parent row.');
                                    RETURN;
                                ELSIF SQLCODE = -2291 THEN
                                    RAISE_APPLICATION_ERROR(-20017, 'The parent row of ' || e.table_name || ' ' || l_pk_after ||
                                        ' does not exist. Restore the parent row first.', TRUE);
                                END IF;
                                RAISE;
                        END;

                        IF e.transaction_type = 'UPDATE' AND l_rows = 0 THEN
                            RAISE_APPLICATION_ERROR(-20018, e.table_name || ' ' || l_pk_after ||
                                ' no longer exists. Restore its DELETE event instead.');
                        END IF;

                        say(p_depth, 'Restored ' || e.table_name || ' ' || e.pk_value_vc ||
                                     ' (undid ' || e.transaction_type || ' at ' ||
                                     TO_CHAR(e.audit_ts, 'YYYY-MM-DD HH24:MI:SS', 'NLS_CALENDAR=GREGORIAN') || ')');
                        IF l_missing IS NOT NULL THEN
                            say(p_depth, '  Not in the audit snapshot, left ' ||
                                         CASE e.transaction_type WHEN 'DELETE' THEN 'NULL/default' ELSE 'as they are' END ||
                                         ': ' || SUBSTR(l_missing, 3));
                        END IF;

                        IF e.transaction_type = 'DELETE' AND p_include_children THEN
                            restore_children(e, l_old, p_force, p_depth, p_seen);
                        END IF;
                    END restore_event;

                    PROCEDURE restore_row(
                        p_transaction_id   IN VARCHAR2,
                        p_include_children IN BOOLEAN DEFAULT TRUE,
                        p_force            IN BOOLEAN DEFAULT FALSE,
                        p_preview          IN BOOLEAN DEFAULT FALSE
                    ) IS
                        l_seen     t_seen;
                        l_module   VARCHAR2(64);
                        l_action   VARCHAR2(64);
                        l_waiting  t_names;
                        l_progress BOOLEAN;
                    BEGIN
                        SAVEPOINT util_audit_restore;
                        g_pending.DELETE;

                        -- Tag the session so the restore's own audit events say what they are
                        DBMS_APPLICATION_INFO.READ_MODULE(l_module, l_action);
                        DBMS_APPLICATION_INFO.SET_ACTION('util_audit.restore_row ' || SUBSTR(p_transaction_id, 1, 40));

                        restore_event(p_transaction_id, p_include_children, p_force, 0, l_seen);

                        -- Retry child rows that waited for another parent row until a round
                        -- restores none of them
                        LOOP
                            EXIT WHEN g_pending.COUNT = 0;
                            l_waiting  := g_pending;
                            g_pending.DELETE;
                            l_progress := FALSE;
                            FOR i IN 1 .. l_waiting.COUNT LOOP
                                IF NOT l_seen.EXISTS(l_waiting(i)) THEN
                                    restore_event(l_waiting(i), p_include_children, p_force, 1, l_seen);
                                    l_progress := l_progress OR l_seen.EXISTS(l_waiting(i));
                                END IF;
                            END LOOP;
                            IF NOT l_progress AND g_pending.COUNT > 0 THEN
                                RAISE_APPLICATION_ERROR(-20017, 'Event ' || g_pending(1) || ' references a parent row ' ||
                                    'that this restore does not bring back. Restore that parent row first.');
                            END IF;
                        END LOOP;

                        IF p_preview THEN
                            ROLLBACK TO util_audit_restore;
                            DBMS_OUTPUT.PUT_LINE('Preview only: all changes rolled back.');
                        END IF;

                        DBMS_APPLICATION_INFO.SET_ACTION(l_action);
                    EXCEPTION
                        WHEN OTHERS THEN
                            ROLLBACK TO util_audit_restore;
                            g_pending.DELETE;
                            DBMS_APPLICATION_INFO.SET_ACTION(l_action);
                            DBMS_OUTPUT.PUT_LINE('Restore failed: all changes rolled back.');
                            RAISE;
                    END restore_row;

                END util_audit_restore;
                /
                ```
        }
    )

    installScript install-util-audit-body (
        execution {
            sequence: 60
        }
        script {
            content:
                ```
                -- Package body util_audit (generated from setup.sql by tools/sync_supporting_objects.py)
                -- util_audit v1 guard
                DECLARE
                    l_v1 NUMBER;
                BEGIN
                    SELECT COUNT(*)
                      INTO l_v1
                      FROM user_tables t
                     WHERE t.table_name = 'UTIL_AUDIT_RECORDS'
                       AND NOT EXISTS (SELECT 1 FROM user_tab_columns c
                                        WHERE c.table_name = t.table_name
                                          AND c.column_name = 'PK_VALUE_VC');
                    IF l_v1 > 0 THEN
                        RAISE_APPLICATION_ERROR(-20100,
                            'This schema has util_audit v1 (UTIL_AUDIT_RECORDS without PK_VALUE_VC). ' ||
                            'Installing over it would break the v1 audit triggers, so nothing was changed. ' ||
                            'Run migrate_v1.sql instead (see docs/migrating-from-v1.md).');
                    END IF;
                END;
                /
                create or replace PACKAGE BODY util_audit AS

                -------------------------------------------------------------------------------
                -- ENABLE TABLE
                -------------------------------------------------------------------------------
                    PROCEDURE enable_table(
                        p_table_name IN VARCHAR2
                    ) IS
                    BEGIN
                        MERGE INTO util_audit_config c
                        USING (SELECT UPPER(p_table_name) table_name FROM dual) src
                        ON (c.table_name = src.table_name)
                        WHEN MATCHED THEN
                            UPDATE SET enabled_flag = 'Y'
                        WHEN NOT MATCHED THEN
                            INSERT (table_name, enabled_flag, created_on, created_by)
                            VALUES (src.table_name, 'Y', SYSDATE, USER);
                    END;

                -------------------------------------------------------------------------------
                -- DISABLE TABLE
                -------------------------------------------------------------------------------
                    PROCEDURE disable_table(
                        p_table_name IN VARCHAR2
                    ) IS
                    BEGIN
                        UPDATE util_audit_config
                        SET enabled_flag = 'N'
                        WHERE table_name = UPPER(p_table_name);
                    END;

                -------------------------------------------------------------------------------
                -- CHECK IF TABLE ENABLED
                -------------------------------------------------------------------------------
                    FUNCTION table_enabled(
                        p_table_name IN VARCHAR2
                    ) RETURN BOOLEAN IS
                        v_flag CHAR(1);
                    BEGIN
                        SELECT enabled_flag
                        INTO v_flag
                        FROM util_audit_config
                        WHERE table_name = UPPER(p_table_name);

                        RETURN NVL(v_flag, 'N') = 'Y';
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                            RETURN FALSE;
                    END;

                    FUNCTION table_enabled_sql(
                        p_table_name IN VARCHAR2
                    ) RETURN Varchar2
                        IS
                    BEGIN
                        IF table_enabled(p_table_name) THEN
                            RETURN 'Y';
                        ELSE
                            RETURN 'N';
                        END IF;
                    END;

                -------------------------------------------------------------------------------
                -- BUILD AUDIT CONTEXT (JSON)
                -------------------------------------------------------------------------------
                    -- Who and where, without repeating what other columns already hold.
                    -- The user is in USERNAME, so it is not repeated here. Empty values are
                    -- skipped.
                    --   APEX: app_id, page_id, session_id, action, ip (the address that
                    --     connected to the web server) and forwarded_for (the X-Forwarded-For
                    --     header, set by proxies and load balancers; the client can fake it).
                    --     MODULE and CLIENT_IDENTIFIER only restate app/page and user:session,
                    --     and the session's IP/host/OS user are the web server's, the same on
                    --     every row, so they are left out.
                    --   Other sessions: module, client_id, action, ip, host, os_user.
                    FUNCTION get_audit_context
                        RETURN CLOB IS
                        l_ctx  json_object_t := json_object_t();
                        l_page VARCHAR2(30);
                        l_ip   VARCHAR2(4000);
                        l_fwd  VARCHAR2(4000);

                        PROCEDURE put(p_key IN VARCHAR2, p_value IN VARCHAR2) IS
                        BEGIN
                            IF p_value IS NOT NULL THEN
                                l_ctx.put(p_key, p_value);
                            END IF;
                        END;
                    BEGIN
                        IF sys_context('APEX$SESSION', 'APP_ID') IS NOT NULL THEN
                            -- Dynamic, so the package compiles where APEX is not installed.
                            -- Separate blocks: a job or REST call has APEX but no CGI env.
                            BEGIN
                                EXECUTE IMMEDIATE 'begin :page := apex_application.g_flow_step_id; end;'
                                    USING OUT l_page;
                            EXCEPTION
                                WHEN OTHERS THEN
                                    NULL;
                            END;
                            BEGIN
                                EXECUTE IMMEDIATE q'[
                                    begin
                                        :ip  := owa_util.get_cgi_env('REMOTE_ADDR');
                                        :fwd := owa_util.get_cgi_env('HTTP_X_FORWARDED_FOR');
                                    end;]'
                                    USING OUT l_ip, OUT l_fwd;
                            EXCEPTION
                                WHEN OTHERS THEN
                                    NULL;
                            END;
                            put('app_id',        sys_context('APEX$SESSION', 'APP_ID'));
                            put('page_id',       l_page);
                            put('session_id',    sys_context('APEX$SESSION', 'APP_SESSION'));
                            put('action',        sys_context('USERENV', 'ACTION'));
                            put('ip',            l_ip);
                            put('forwarded_for', l_fwd);
                        ELSE
                            put('module',     sys_context('USERENV', 'MODULE'));
                            put('client_id',  sys_context('USERENV', 'CLIENT_IDENTIFIER'));
                            put('action',     sys_context('USERENV', 'ACTION'));
                            put('ip',         sys_context('USERENV', 'IP_ADDRESS'));
                            put('host',       sys_context('USERENV', 'HOST'));
                            put('os_user',    sys_context('USERENV', 'OS_USER'));
                        END IF;

                        RETURN l_ctx.to_clob;
                    END;
                -------------------------------------------------------------------------------
                -- CAPTURE AUDIT
                -------------------------------------------------------------------------------
                    PROCEDURE capture_audit(
                        p_transaction_json IN json_object_t
                    ) IS
                        -- Longest value prefix fed to the change hash. 990 chars stays under
                        -- the 4000-byte SQL limit even at 4 bytes per character.
                        c_hash_chars CONSTANT PLS_INTEGER := 990;

                        TYPE t_vc   IS TABLE OF VARCHAR2(4000) INDEX BY PLS_INTEGER;
                        TYPE t_clob IS TABLE OF CLOB INDEX BY PLS_INTEGER;

                        -- util_audit v1 triggers send trans_type instead of transaction_type,
                        -- no row snapshots, and every column on every update
                        l_v1       BOOLEAN := NOT p_transaction_json.has('transaction_type')
                                              AND p_transaction_json.has('trans_type');
                        l_txn_id   util_audit_txn.transaction_id%TYPE   := NVL(p_transaction_json.get_string('transaction_id'),
                                                                               RAWTOHEX(SYS_GUID()));
                        l_table    util_audit_txn.table_name%TYPE       := p_transaction_json.get_string('table_name');
                        l_pk       util_audit_txn.pk_value_vc%TYPE      := p_transaction_json.get_string('pk_value');
                        l_type     util_audit_txn.transaction_type%TYPE := NVL(p_transaction_json.get_string('transaction_type'),
                                                                               p_transaction_json.get_string('trans_type'));
                        l_user     util_audit_txn.username%TYPE         := p_transaction_json.get_string('user_name');
                        l_cols     json_array_t                         := p_transaction_json.get_array('columns');
                        l_col      json_object_t;
                        l_val      VARCHAR2(32767);
                        l_db_txn   util_audit_txn.db_transaction_id%TYPE := dbms_transaction.local_transaction_id;
                        l_context  CLOB := get_audit_context;
                        l_old_row  CLOB;
                        l_new_row  CLOB;
                        l_n        PLS_INTEGER := 0;

                        l_col_name t_vc;
                        l_dt       t_vc;
                        l_old_vc   t_vc;
                        l_new_vc   t_vc;
                        l_old_clob t_clob;
                        l_new_clob t_clob;
                        l_old_h    t_vc;
                        l_new_h    t_vc;
                        l_pk_h     VARCHAR2(4000) := SUBSTR(l_pk, 1, c_hash_chars);

                        -- Non-CLOB values go to the VARCHAR2 column when they fit in 4000
                        -- bytes, otherwise to the CLOB column.
                        PROCEDURE split_value(
                            p_key  IN VARCHAR2,
                            p_i    IN PLS_INTEGER,
                            p_vc   IN OUT NOCOPY t_vc,
                            p_clob IN OUT NOCOPY t_clob,
                            p_hash IN OUT NOCOPY t_vc
                        ) IS
                        BEGIN
                            p_vc(p_i)   := NULL;
                            p_clob(p_i) := NULL;

                            IF l_dt(p_i) = 'CLOB' THEN
                                -- get_clob turns a JSON null into the text 'null'
                                IF l_col.has(p_key) AND NOT l_col.get(p_key).is_null THEN
                                    p_clob(p_i) := l_col.get_clob(p_key);
                                END IF;
                                p_hash(p_i) := DBMS_LOB.SUBSTR(p_clob(p_i), c_hash_chars, 1);
                            ELSE
                                l_val := l_col.get_string(p_key);
                                IF LENGTHB(l_val) > 4000 THEN
                                    p_clob(p_i) := TO_CLOB(l_val);
                                ELSE
                                    p_vc(p_i) := l_val;
                                END IF;
                                p_hash(p_i) := SUBSTR(l_val, 1, c_hash_chars);
                            END IF;
                        END;
                    BEGIN
                        IF p_transaction_json.get_object('old_row') IS NOT NULL THEN
                            l_old_row := p_transaction_json.get_object('old_row').to_clob;
                        END IF;
                        IF p_transaction_json.get_object('new_row') IS NOT NULL THEN
                            l_new_row := p_transaction_json.get_object('new_row').to_clob;
                        END IF;

                        ----------------------------------------------------------------------------
                        -- 1) The changed columns
                        ----------------------------------------------------------------------------
                        FOR i IN 0 .. l_cols.get_size - 1 LOOP
                            l_col := TREAT(l_cols.get(i) AS json_object_t);
                            l_n   := l_n + 1;
                            l_col_name(l_n) := l_col.get_string('column_name');
                            l_dt(l_n)       := NVL(l_col.get_string('data_type'), l_col.get_string('datatype'));
                            split_value('old_value', l_n, l_old_vc, l_old_clob, l_old_h);
                            split_value('new_value', l_n, l_new_vc, l_new_clob, l_new_h);

                            -- v1 sends unchanged columns too; keep only real changes, as v1 did
                            IF l_v1 AND (
                                   (l_old_vc(l_n) IS NULL AND l_new_vc(l_n) IS NULL
                                    AND l_old_clob(l_n) IS NULL AND l_new_clob(l_n) IS NULL)
                                -- Compared as bytes, so a case-only change counts under
                                -- a linguistic NLS_COMP
                                OR UTL_I18N.STRING_TO_RAW(l_old_vc(l_n), 'AL32UTF8')
                                   = UTL_I18N.STRING_TO_RAW(l_new_vc(l_n), 'AL32UTF8')
                                OR (l_old_clob(l_n) IS NOT NULL AND l_new_clob(l_n) IS NOT NULL
                                    AND DBMS_LOB.COMPARE(l_old_clob(l_n), l_new_clob(l_n)) = 0)) THEN
                                l_col_name.DELETE(l_n);
                                l_n := l_n - 1;
                            END IF;
                        END LOOP;

                        -- A v1 update that changed nothing records nothing, as in v1
                        IF l_v1 AND l_n = 0 THEN
                            RETURN;
                        END IF;

                        ----------------------------------------------------------------------------
                        -- 2) Header row, one per audited row event
                        ----------------------------------------------------------------------------
                        INSERT INTO util_audit_txn
                        (transaction_id,
                         db_transaction_id,
                         table_name,
                         pk_value_vc,
                         transaction_type,
                         username,
                         audit_context,
                         old_row_json,
                         new_row_json,
                         audit_ts)
                        VALUES
                        (l_txn_id,
                         l_db_txn,
                         l_table,
                         l_pk,
                         l_type,
                         l_user,
                         l_context,
                         l_old_row,
                         l_new_row,
                         SYSTIMESTAMP);


                        -- The hash covers table, column, PK and the first 990 chars of each
                        -- value. Each part is hashed on its own, so no input exceeds 4000 bytes
                        -- and parts cannot run into each other.
                        FORALL i IN INDICES OF l_col_name
                            INSERT INTO util_audit_records
                            (transaction_id,
                             table_name,
                             pk_value_vc,
                             transaction_type,
                             username,
                             column_name,
                             data_type,
                             old_value,
                             new_value,
                             old_clob,
                             new_clob,
                             change_hash,
                             audit_ts)
                            VALUES
                            (l_txn_id,
                             l_table,
                             l_pk,
                             l_type,
                             l_user,
                             l_col_name(i),
                             l_dt(i),
                             l_old_vc(i),
                             l_new_vc(i),
                             l_old_clob(i),
                             l_new_clob(i),
                             STANDARD_HASH(
                                 RAWTOHEX(STANDARD_HASH(l_table || CHR(31) || l_col_name(i), 'SHA256')) ||
                                 RAWTOHEX(STANDARD_HASH(l_pk_h, 'SHA256')) ||
                                 RAWTOHEX(STANDARD_HASH(l_old_h(i), 'SHA256')) ||
                                 RAWTOHEX(STANDARD_HASH(l_new_h(i), 'SHA256')),
                                 'SHA256'),
                             SYSTIMESTAMP);

                    EXCEPTION
                        WHEN OTHERS THEN
                            -- Triggers cannot use savepoints, so remove a half-written event
                            -- by hand before passing the error on.
                            DELETE FROM util_audit_records WHERE transaction_id = l_txn_id;
                            DELETE FROM util_audit_txn     WHERE transaction_id = l_txn_id;
                            RAISE;
                    END capture_audit;

                -------------------------------------------------------------------------------
                -- LOG ERROR
                -------------------------------------------------------------------------------
                    PROCEDURE log_error(
                        p_table_name       IN VARCHAR2,
                        p_transaction_type IN VARCHAR2,
                        p_pk_value         IN VARCHAR2,
                        p_error_code       IN NUMBER,
                        p_error_message    IN VARCHAR2,
                        p_error_backtrace  IN VARCHAR2
                    ) IS
                        PRAGMA AUTONOMOUS_TRANSACTION;
                    BEGIN
                        INSERT INTO util_audit_errors
                        (table_name,
                         transaction_type,
                         pk_value_vc,
                         username,
                         error_code,
                         error_message,
                         error_backtrace)
                        VALUES
                        (SUBSTR(p_table_name, 1, 255),
                         SUBSTR(p_transaction_type, 1, 6),
                         SUBSTRB(p_pk_value, 1, 4000),
                         SUBSTR(NVL(sys_context('APEX$SESSION', 'APP_USER'), USER), 1, 255),
                         p_error_code,
                         SUBSTRB(p_error_message, 1, 4000),
                         SUBSTRB(p_error_backtrace, 1, 4000));
                        COMMIT;
                    EXCEPTION
                        WHEN OTHERS THEN
                            ROLLBACK;
                    END log_error;

                -------------------------------------------------------------------------------
                -- PURGE
                -------------------------------------------------------------------------------
                    PROCEDURE purge(
                        p_before         IN  TIMESTAMP,
                        p_table_name     IN  VARCHAR2 DEFAULT NULL,
                        p_events_deleted OUT NUMBER
                    ) IS
                    BEGIN
                        DELETE FROM util_audit_records r
                        WHERE r.transaction_id IN (
                            SELECT t.transaction_id
                            FROM util_audit_txn t
                            WHERE t.audit_ts < p_before
                              AND (p_table_name IS NULL OR t.table_name = UPPER(p_table_name)));

                        DELETE FROM util_audit_txn t
                        WHERE t.audit_ts < p_before
                          AND (p_table_name IS NULL OR t.table_name = UPPER(p_table_name));

                        p_events_deleted := SQL%ROWCOUNT;
                    END purge;

                    PROCEDURE purge_errors(
                        p_before         IN  TIMESTAMP,
                        p_errors_deleted OUT NUMBER
                    ) IS
                    BEGIN
                        DELETE FROM util_audit_errors WHERE error_ts < p_before;
                        p_errors_deleted := SQL%ROWCOUNT;
                    END purge_errors;

                -------------------------------------------------------------------------------
                -- RESTORE (the work is in util_audit_restore)
                -------------------------------------------------------------------------------
                    PROCEDURE restore_row(
                        p_transaction_id   IN VARCHAR2,
                        p_include_children IN BOOLEAN DEFAULT TRUE,
                        p_force            IN BOOLEAN DEFAULT FALSE,
                        p_preview          IN BOOLEAN DEFAULT FALSE
                    ) IS
                    BEGIN
                        util_audit_restore.restore_row(p_transaction_id, p_include_children, p_force, p_preview);
                    END restore_row;

                END util_audit;
                /
                ```
        }
    )

    installScript install-util-audit-gen-spec (
        execution {
            sequence: 70
        }
        script {
            content:
                ```
                -- Package util_audit_gen (generated from setup.sql by tools/sync_supporting_objects.py)
                -- util_audit v1 guard
                DECLARE
                    l_v1 NUMBER;
                BEGIN
                    SELECT COUNT(*)
                      INTO l_v1
                      FROM user_tables t
                     WHERE t.table_name = 'UTIL_AUDIT_RECORDS'
                       AND NOT EXISTS (SELECT 1 FROM user_tab_columns c
                                        WHERE c.table_name = t.table_name
                                          AND c.column_name = 'PK_VALUE_VC');
                    IF l_v1 > 0 THEN
                        RAISE_APPLICATION_ERROR(-20100,
                            'This schema has util_audit v1 (UTIL_AUDIT_RECORDS without PK_VALUE_VC). ' ||
                            'Installing over it would break the v1 audit triggers, so nothing was changed. ' ||
                            'Run migrate_v1.sql instead (see docs/migrating-from-v1.md).');
                    END IF;
                END;
                /
                create or replace PACKAGE util_audit_gen AS
                    ------------------------------------------------------------------------------
                    -- util_audit_gen
                    --
                    -- Trigger generator for util_audit (v2).
                    --
                    -- Generates a row-level AFTER INSERT/UPDATE/DELETE trigger that:
                    --   - Normalizes transaction_type via INSERTING/UPDATING/DELETING
                    --   - Skips all work when the table is disabled in util_audit_config
                    --   - Leaves ignored columns (standard set + configurable list) out of the
                    --     changes; they stay in the row snapshots
                    --   - Audits only supported datatypes
                    --   - Records only changed columns on UPDATE, and only non-NULL columns
                    --     on INSERT and DELETE
                    --   - Skips calling util_audit.capture_audit on an UPDATE that changed
                    --     no audited column
                    --   - Captures row snapshots (old_row/new_row) as JSON
                    --   - Logs audit failures to util_audit_errors instead of failing the DML
                    --
                    -- create_audit_trigger also prints (DBMS_OUTPUT) every child table that
                    -- references the table, and whether that child table is audited.
                    --
                    -- create_audit_trigger registers the table in util_audit_config if it is
                    -- not there yet. An existing enabled/disabled flag is left as it is.
                    --
                    -- Notes:
                    --   * Designed for "single-row" triggers (FOR EACH ROW).
                    --   * PK can be any datatype. A single-column PK is stored as its value
                    --     (numbers/dates/timestamps via TO_CHAR). A composite PK is stored as
                    --     a JSON object, e.g. {"ORDER_ID":"100","LINE_NO":"1"}.
                    ------------------------------------------------------------------------------

                    -- Generate or execute the trigger DDL
                    -- p_action: 'EXECUTE' or 'GENERATE'
                    PROCEDURE create_audit_trigger(
                        p_table_name IN VARCHAR2,
                        p_action     IN VARCHAR2 DEFAULT 'EXECUTE'
                    );

                    -- Drop the trigger if it exists
                    PROCEDURE drop_audit_trigger(
                        p_table_name IN VARCHAR2,
                        p_action     IN VARCHAR2 DEFAULT 'EXECUTE'
                    );

                    -- Set additional ignored columns for this session only
                    -- (comma-separated, case-insensitive). Applies to every table.
                    PROCEDURE set_ignored_columns(
                        p_columns IN VARCHAR2
                    );

                    -- Store the columns one table's trigger should skip (comma-separated,
                    -- case-insensitive) in util_audit_config. When p_regenerate is TRUE and
                    -- the table has an audit trigger, the trigger is re-created right away.
                    PROCEDURE set_table_ignored_columns(
                        p_table_name IN VARCHAR2,
                        p_columns    IN VARCHAR2,
                        p_regenerate IN BOOLEAN DEFAULT TRUE
                    );

                    -- Store the columns one table's trigger must never record, not in the
                    -- column changes and not in the row snapshots: passwords, token hashes
                    -- and other secrets (comma-separated, case-insensitive). Ignored columns
                    -- are different: they stay in the snapshots so restore can bring them
                    -- back. A primary key column cannot be excluded.
                    -- p_regenerate:    re-create the trigger right away if the table has one
                    -- p_scrub_history: also remove these columns from history already
                    --                  recorded (see scrub_columns). Does not commit.
                    PROCEDURE set_table_excluded_columns(
                        p_table_name    IN VARCHAR2,
                        p_columns       IN VARCHAR2,
                        p_regenerate    IN BOOLEAN DEFAULT TRUE,
                        p_scrub_history IN BOOLEAN DEFAULT FALSE
                    );

                    -- Removes columns from one table's recorded history: from the row
                    -- snapshots of every event and the column changes. Use it when a
                    -- secret was audited before it was excluded. Archive files already
                    -- made (util_audit_archive) are not changed. Does not commit.
                    PROCEDURE scrub_columns(
                        p_table_name IN VARCHAR2,
                        p_columns    IN VARCHAR2
                    );

                    -- The CREATE TRIGGER statement create_audit_trigger would run
                    FUNCTION get_trigger_ddl(
                        p_table_name IN VARCHAR2
                    ) RETURN CLOB;

                    -- Re-create every existing audit trigger, e.g. after an upgrade.
                    -- Tables that fail are reported (DBMS_OUTPUT) and skipped; the call then
                    -- raises ORA-20004 naming how many failed.
                    PROCEDURE recreate_all_triggers;

                END util_audit_gen;
                /
                ```
        }
    )

    installScript install-util-audit-gen-body (
        execution {
            sequence: 80
        }
        script {
            content:
                ```
                -- Package body util_audit_gen (generated from setup.sql by tools/sync_supporting_objects.py)
                -- util_audit v1 guard
                DECLARE
                    l_v1 NUMBER;
                BEGIN
                    SELECT COUNT(*)
                      INTO l_v1
                      FROM user_tables t
                     WHERE t.table_name = 'UTIL_AUDIT_RECORDS'
                       AND NOT EXISTS (SELECT 1 FROM user_tab_columns c
                                        WHERE c.table_name = t.table_name
                                          AND c.column_name = 'PK_VALUE_VC');
                    IF l_v1 > 0 THEN
                        RAISE_APPLICATION_ERROR(-20100,
                            'This schema has util_audit v1 (UTIL_AUDIT_RECORDS without PK_VALUE_VC). ' ||
                            'Installing over it would break the v1 audit triggers, so nothing was changed. ' ||
                            'Run migrate_v1.sql instead (see docs/migrating-from-v1.md).');
                    END IF;
                END;
                /
                create or replace PACKAGE BODY util_audit_gen AS

                    g_ignored_columns VARCHAR2(32767);

                    --------------------------------------------------------------------------
                    -- Helpers
                    --------------------------------------------------------------------------
                    FUNCTION norm_name(p_name IN VARCHAR2) RETURN VARCHAR2 IS
                    BEGIN
                        RETURN UPPER(TRIM(p_name));
                    END;

                    -- Quoted identifier, so mixed-case and reserved-word names compile
                    FUNCTION q(p_name IN VARCHAR2) RETURN VARCHAR2 IS
                    BEGIN
                        RETURN '"' || p_name || '"';
                    END;

                    -- Quoted string literal
                    FUNCTION lit(p_text IN VARCHAR2) RETURN VARCHAR2 IS
                    BEGIN
                        RETURN '''' || REPLACE(p_text, '''', '''''') || '''';
                    END;

                    -- The util_audit trigger already on the table, if any
                    FUNCTION current_trigger(p_table_name IN VARCHAR2) RETURN VARCHAR2 IS
                        v_table VARCHAR2(128) := norm_name(p_table_name);
                        v_name  VARCHAR2(128);
                    BEGIN
                        SELECT MIN(trigger_name) INTO v_name
                        FROM v_util_audit_triggers
                        WHERE table_name = v_table
                          AND (trigger_name LIKE 'AUD\_%' ESCAPE '\' OR trigger_name LIKE 'UA\_AUD\_%' ESCAPE '\');
                        RETURN v_name;
                    END;

                    FUNCTION base_trig_name(p_table_name IN VARCHAR2) RETURN VARCHAR2 IS
                        v_table VARCHAR2(128) := norm_name(p_table_name);
                    BEGIN
                        -- Names are limited to 128 bytes. Very long table names are cut and
                        -- given a hash suffix so two tables never share a trigger name.
                        IF LENGTHB(v_table) <= 124 THEN
                            RETURN 'AUD_' || v_table;
                        END IF;
                        RETURN 'AUD_' || SUBSTRB(v_table, 1, 114) || '_' ||
                               TO_CHAR(DBMS_UTILITY.GET_HASH_VALUE(v_table, 0, 2147483647), 'FM0XXXXXXX');
                    END;

                    -- The name for the table's trigger: the one it already has, else
                    -- AUD_<table>, else UA_AUD_<table> when AUD_<table> belongs to someone
                    -- else's trigger
                    FUNCTION trig_name(p_table_name IN VARCHAR2) RETURN VARCHAR2 IS
                        v_current VARCHAR2(128) := current_trigger(p_table_name);
                        v_base    VARCHAR2(128) := base_trig_name(p_table_name);
                        v_taken   NUMBER;
                    BEGIN
                        IF v_current IS NOT NULL
                           AND v_current IN (v_base, SUBSTRB('UA_' || v_base, 1, 128)) THEN
                            RETURN v_current;
                        END IF;
                        SELECT COUNT(*) INTO v_taken FROM user_triggers WHERE trigger_name = v_base;
                        IF v_taken = 0 THEN
                            RETURN v_base;
                        END IF;
                        RETURN SUBSTRB('UA_' || v_base, 1, 128);
                    END;

                    PROCEDURE exec_sql(p_sql IN CLOB, p_action IN VARCHAR2) IS
                    BEGIN
                        IF norm_name(p_action) = 'GENERATE' THEN
                            -- Line by line: DBMS_OUTPUT cannot take more than 32K at once
                            DECLARE
                                l_pos PLS_INTEGER := 1;
                                l_nl  PLS_INTEGER;
                                l_len PLS_INTEGER := NVL(DBMS_LOB.GETLENGTH(p_sql), 0);
                            BEGIN
                                WHILE l_pos <= l_len LOOP
                                    l_nl := DBMS_LOB.INSTR(p_sql, CHR(10), l_pos);
                                    IF l_nl = 0 THEN
                                        l_nl := l_len + 1;
                                    END IF;
                                    DBMS_OUTPUT.PUT_LINE(DBMS_LOB.SUBSTR(p_sql, l_nl - l_pos, l_pos));
                                    l_pos := l_nl + 1;
                                END LOOP;
                            END;
                            DBMS_OUTPUT.PUT_LINE(CHR(10));
                            RETURN;
                        END IF;

                        EXECUTE IMMEDIATE p_sql;
                    END;

                    FUNCTION in_list(p_list IN VARCHAR2, p_item IN VARCHAR2) RETURN BOOLEAN IS
                    BEGIN
                        RETURN INSTR(',' || UPPER(REPLACE(NVL(p_list,''),' ','')) || ',',
                                     ',' || UPPER(TRIM(p_item)) || ',') > 0;
                    END;

                    FUNCTION is_ignored_column(p_col IN VARCHAR2, p_table_list IN VARCHAR2) RETURN BOOLEAN IS
                        v_col VARCHAR2(128) := UPPER(TRIM(p_col));
                    BEGIN
                        -- Who/when bookkeeping columns: changing only these records nothing
                        IF v_col IN (
                            'CREATED','CREATED_ON','CREATED_BY',
                            'UPDATED','UPDATED_ON','UPDATED_BY',
                            'MODIFIED','MODIFIED_ON','MODIFIED_BY'
                        ) THEN
                            RETURN TRUE;
                        END IF;

                        -- Per-table ignores from util_audit_config
                        IF p_table_list IS NOT NULL AND in_list(p_table_list, v_col) THEN
                            RETURN TRUE;
                        END IF;

                        -- Session-level ignores from set_ignored_columns
                        IF g_ignored_columns IS NOT NULL AND in_list(g_ignored_columns, v_col) THEN
                            RETURN TRUE;
                        END IF;

                        RETURN FALSE;
                    END;

                    FUNCTION supported_datatype(p_data_type IN VARCHAR2) RETURN BOOLEAN IS
                        v_dt VARCHAR2(128) := UPPER(TRIM(p_data_type));
                    BEGIN
                        IF v_dt IN ('NUMBER','FLOAT','BINARY_FLOAT','BINARY_DOUBLE',
                                    'VARCHAR2','CHAR','NCHAR','NVARCHAR2',
                                    'DATE','CLOB','RAW') THEN
                            RETURN TRUE;
                        END IF;

                        IF v_dt LIKE 'TIMESTAMP%' THEN
                            RETURN TRUE;
                        END IF;

                        IF v_dt LIKE 'INTERVAL %' THEN
                            RETURN TRUE;
                        END IF;

                        -- Exclusions: BLOB, LONG, XMLTYPE, object types, etc.
                        RETURN FALSE;
                    END;

                    -- Build an expression that returns a VARCHAR2 representation of a bind.
                    -- p_ref is the full bind reference, e.g. :NEW."AMOUNT".
                    -- Output does not depend on session NLS settings.
                    FUNCTION to_char_expr(p_ref IN VARCHAR2, p_data_type IN VARCHAR2)
                        RETURN VARCHAR2
                    IS
                        v_dt VARCHAR2(128) := UPPER(TRIM(p_data_type));
                    BEGIN
                        IF v_dt IN ('VARCHAR2','CHAR','NCHAR','NVARCHAR2','CLOB') THEN
                            -- CLOBs are put into the JSON as-is
                            RETURN p_ref;
                        ELSIF v_dt IN ('NUMBER','FLOAT','BINARY_FLOAT','BINARY_DOUBLE') THEN
                            RETURN 'TO_CHAR(' || p_ref || q'[, 'TM9', 'NLS_NUMERIC_CHARACTERS=''.,''')]';
                        ELSIF v_dt = 'RAW' THEN
                            RETURN 'RAWTOHEX(' || p_ref || ')';
                        -- Dates always in the Gregorian calendar, whatever the session uses
                        ELSIF v_dt = 'DATE' THEN
                            RETURN 'TO_CHAR(' || p_ref || q'[, 'YYYY-MM-DD"T"HH24:MI:SS', 'NLS_CALENDAR=GREGORIAN')]';
                        ELSIF v_dt LIKE 'TIMESTAMP% WITH LOCAL TIME ZONE' THEN
                            -- TZH/TZM are not valid for LTZ; cast to keep the offset
                            RETURN 'TO_CHAR(CAST(' || p_ref || ' AS TIMESTAMP WITH TIME ZONE)' ||
                                   q'[, 'YYYY-MM-DD"T"HH24:MI:SS.FF TZH:TZM', 'NLS_CALENDAR=GREGORIAN')]';
                        ELSIF v_dt LIKE 'TIMESTAMP% WITH TIME ZONE' THEN
                            RETURN 'TO_CHAR(' || p_ref || q'[, 'YYYY-MM-DD"T"HH24:MI:SS.FF TZH:TZM', 'NLS_CALENDAR=GREGORIAN')]';
                        ELSIF v_dt LIKE 'TIMESTAMP%' THEN
                            RETURN 'TO_CHAR(' || p_ref || q'[, 'YYYY-MM-DD"T"HH24:MI:SS.FF', 'NLS_CALENDAR=GREGORIAN')]';
                        ELSE
                            -- INTERVAL and anything else
                            RETURN 'TO_CHAR(' || p_ref || ')';
                        END IF;
                    END;

                    -- Comparison predicate that handles NULL properly.
                    FUNCTION changed_predicate(p_col IN VARCHAR2, p_data_type IN VARCHAR2) RETURN VARCHAR2 IS
                        v_dt VARCHAR2(128) := UPPER(TRIM(p_data_type));
                        v_new VARCHAR2(4000) := ':NEW.' || q(p_col);
                        v_old VARCHAR2(4000) := ':OLD.' || q(p_col);
                    BEGIN
                        -- For LOBs, direct != is not allowed; use DBMS_LOB.COMPARE and NULL checks.
                        IF v_dt = 'CLOB' THEN
                            RETURN '(' ||
                                   '(' || v_new || ' IS NULL AND ' || v_old || ' IS NOT NULL)' ||
                                   ' OR (' || v_new || ' IS NOT NULL AND ' || v_old || ' IS NULL)' ||
                                   ' OR (' || v_new || ' IS NOT NULL AND ' || v_old || ' IS NOT NULL AND ' ||
                                         'DBMS_LOB.COMPARE(' || v_new || ',' || v_old || ') != 0)' ||
                                   ')';
                        END IF;

                        -- Character values compare as bytes: with NLS_COMP=LINGUISTIC a plain
                        -- != would miss changes such as 'smith' -> 'Smith'
                        IF v_dt IN ('VARCHAR2','CHAR','NCHAR','NVARCHAR2') THEN
                            v_new := 'UTL_I18N.STRING_TO_RAW(' || v_new || ', ''AL32UTF8'')';
                            v_old := 'UTL_I18N.STRING_TO_RAW(' || v_old || ', ''AL32UTF8'')';
                        END IF;

                        RETURN '(' ||
                               '(' || v_new || ' != ' || v_old || ')' ||
                               ' OR (' || v_new || ' IS NULL AND ' || v_old || ' IS NOT NULL)' ||
                               ' OR (' || v_new || ' IS NOT NULL AND ' || v_old || ' IS NULL)' ||
                               ')';
                    END;

                    PROCEDURE set_ignored_columns(p_columns IN VARCHAR2) IS
                    BEGIN
                        g_ignored_columns := p_columns;
                    END;

                    -- Prints the tables that reference p_table_name through a foreign key.
                    -- util_audit.restore_row can only bring back child rows from audited
                    -- child tables, so this shows the gaps up front.
                    PROCEDURE report_child_tables(p_table_name IN VARCHAR2) IS
                        v_found BOOLEAN := FALSE;
                    BEGIN
                        FOR fk IN (
                            SELECT child_table, constraint_name, delete_rule, child_audited
                            FROM v_util_audit_child_tables
                            WHERE parent_table = p_table_name
                            ORDER BY child_table, constraint_name
                        ) LOOP
                            IF NOT v_found THEN
                                DBMS_OUTPUT.PUT_LINE('Child tables of ' || p_table_name || ':');
                                v_found := TRUE;
                            END IF;
                            DBMS_OUTPUT.PUT_LINE('  ' || fk.child_table || ' (' || fk.constraint_name ||
                                                 ', ON DELETE ' || fk.delete_rule || '): ' ||
                                CASE WHEN fk.child_audited = 'Y' THEN 'audited'
                                     ELSE 'NOT audited, so util_audit.restore_row cannot bring back its rows. ' ||
                                          'Audit ' || fk.child_table || ' too to include it.'
                                END);
                        END LOOP;

                        IF NOT v_found THEN
                            DBMS_OUTPUT.PUT_LINE('No child tables reference ' || p_table_name || '.');
                        END IF;
                    END;

                    --------------------------------------------------------------------------
                    -- Public: Drop trigger
                    --------------------------------------------------------------------------
                    PROCEDURE drop_audit_trigger(
                        p_table_name IN VARCHAR2,
                        p_action     IN VARCHAR2 DEFAULT 'EXECUTE'
                    ) IS
                        v_table_name VARCHAR2(128) := norm_name(p_table_name);
                    BEGIN
                        -- Every trigger on this table that calls util_audit, and no other
                        FOR t IN (
                            SELECT trigger_name
                            FROM v_util_audit_triggers
                            WHERE table_name = v_table_name
                        ) LOOP
                            exec_sql('DROP TRIGGER ' || q(t.trigger_name), p_action);
                        END LOOP;
                    END;

                    --------------------------------------------------------------------------
                    -- Public: Trigger DDL
                    --------------------------------------------------------------------------
                    FUNCTION get_trigger_ddl(
                        p_table_name IN VARCHAR2
                    ) RETURN CLOB IS
                        TYPE t_names IS TABLE OF VARCHAR2(128) INDEX BY PLS_INTEGER;

                        v_table_name VARCHAR2(128) := norm_name(p_table_name);
                        v_trg_name   VARCHAR2(128) := trig_name(p_table_name);
                        v_table_lit  VARCHAR2(512) := lit(v_table_name);

                        v_pk_cols    t_names;
                        v_pk_dts     t_names;
                        v_ignored    util_audit_config.ignored_columns%TYPE;
                        v_excluded   util_audit_config.excluded_columns%TYPE;
                        v_track      BOOLEAN;

                        v_sql        CLOB;
                        v_has_cols   BOOLEAN := FALSE;

                        -- local utility to append
                        PROCEDURE ap(p IN VARCHAR2) IS
                        BEGIN
                            v_sql := v_sql || p || CHR(10);
                        END;

                        -- :NEW value on INSERT, :OLD value otherwise
                        FUNCTION pk_part(p_col IN VARCHAR2, p_dt IN VARCHAR2) RETURN VARCHAR2 IS
                        BEGIN
                            RETURN 'CASE WHEN INSERTING THEN ' || to_char_expr(':NEW.' || q(p_col), p_dt) ||
                                   ' ELSE ' || to_char_expr(':OLD.' || q(p_col), p_dt) || ' END';
                        END;

                    BEGIN
                        -- Validate table exists
                        DECLARE
                            v_cnt NUMBER;
                        BEGIN
                            SELECT COUNT(*)
                            INTO v_cnt
                            FROM user_tables
                            WHERE table_name = v_table_name;

                            IF v_cnt = 0 THEN
                                RAISE_APPLICATION_ERROR(-20001, 'Table not found in schema: ' || v_table_name);
                            END IF;
                            -- Auditing the audit tables would recurse
                            IF v_table_name LIKE 'UTIL\_AUDIT\_%' ESCAPE '\' THEN
                                RAISE_APPLICATION_ERROR(-20005, 'util_audit''s own tables cannot be audited: ' || v_table_name);
                            END IF;
                        END;

                        -- Primary key columns and datatypes, in key order
                        SELECT cols.column_name, tc.data_type
                        BULK COLLECT INTO v_pk_cols, v_pk_dts
                        FROM user_constraints cons
                        JOIN user_cons_columns cols
                          ON cons.constraint_name = cols.constraint_name
                         AND cons.owner          = cols.owner
                        JOIN user_tab_columns tc
                          ON tc.table_name  = cons.table_name
                         AND tc.column_name = cols.column_name
                        WHERE cons.table_name = v_table_name
                          AND cons.constraint_type = 'P'
                        ORDER BY cols.position;

                        IF v_pk_cols.COUNT = 0 THEN
                            RAISE_APPLICATION_ERROR(-20002, 'No primary key found for table: ' || v_table_name);
                        END IF;

                        BEGIN
                            SELECT ignored_columns, excluded_columns INTO v_ignored, v_excluded
                            FROM util_audit_config
                            WHERE table_name = v_table_name;
                        EXCEPTION
                            WHEN NO_DATA_FOUND THEN
                                v_ignored  := NULL;
                                v_excluded := NULL;
                        END;

                        v_sql := EMPTY_CLOB();

                        ap('CREATE OR REPLACE TRIGGER ' || q(v_trg_name));
                        ap('AFTER INSERT OR UPDATE OR DELETE ON ' || q(v_table_name));
                        ap('FOR EACH ROW');
                        IF v_excluded IS NOT NULL THEN
                            ap('-- Never recorded (excluded): ' || REPLACE(v_excluded, ',', ', '));
                        END IF;
                        ap('DECLARE');
                        ap('    l_txn_id    VARCHAR2(64) := RAWTOHEX(SYS_GUID());');
                        ap('    l_action    VARCHAR2(6);');
                        ap('    l_pk        VARCHAR2(4000);');
                        ap('    l_has_changes BOOLEAN := FALSE;');
                        ap('    v_audit_json JSON_OBJECT_T;');
                        ap('    v_cols_arr   JSON_ARRAY_T;');
                        ap('    v_col_obj    JSON_OBJECT_T;');
                        ap('    v_old_row    JSON_OBJECT_T;');
                        ap('    v_new_row    JSON_OBJECT_T;');
                        IF v_pk_cols.COUNT > 1 THEN
                            ap('    v_pk_obj     JSON_OBJECT_T;');
                        END IF;
                        ap('    l_err_code  NUMBER;');
                        ap('    l_err_msg   VARCHAR2(4000);');
                        ap('    l_err_trace VARCHAR2(4000);');
                        ap('');
                        ap('    -- Last resort when util_audit itself cannot log: write the error');
                        ap('    -- straight to UTIL_AUDIT_ERRORS in its own transaction');
                        ap('    PROCEDURE log_direct IS');
                        ap('        PRAGMA AUTONOMOUS_TRANSACTION;');
                        ap('    BEGIN');
                        ap('        INSERT INTO util_audit_errors');
                        ap('            (table_name, transaction_type, pk_value_vc, username, error_code, error_message, error_backtrace)');
                        ap('        VALUES (' || v_table_lit || ', l_action, SUBSTRB(l_pk, 1, 4000),');
                        ap('            SUBSTR(NVL(sys_context(''APEX$SESSION'', ''APP_USER''), USER), 1, 255),');
                        ap('            l_err_code, l_err_msg, l_err_trace);');
                        ap('        COMMIT;');
                        ap('    EXCEPTION');
                        ap('        WHEN OTHERS THEN');
                        ap('            ROLLBACK;');
                        ap('    END;');
                        ap('BEGIN');
                        ap('    -- Normalize transaction type (do NOT rely on ORA_SYSEVENT)');
                        ap('    l_action := CASE');
                        ap('        WHEN INSERTING THEN ''INSERT''');
                        ap('        WHEN UPDATING  THEN ''UPDATE''');
                        ap('        WHEN DELETING  THEN ''DELETE''');
                        ap('    END;');
                        ap('');
                        ap('    -- Skip when auditing is disabled in util_audit_config');
                        ap('    IF NOT util_audit.table_enabled(' || v_table_lit || ') THEN');
                        ap('        RETURN;');
                        ap('    END IF;');
                        ap('');

                        -- pk_value serialization
                        ap('    -- Primary key value');
                        IF v_pk_cols.COUNT = 1 THEN
                            ap('    l_pk := ' || pk_part(v_pk_cols(1), v_pk_dts(1)) || ';');
                        ELSE
                            ap('    v_pk_obj := JSON_OBJECT_T();');
                            FOR i IN 1 .. v_pk_cols.COUNT LOOP
                                ap('    v_pk_obj.put(' || lit(v_pk_cols(i)) || ', ' || pk_part(v_pk_cols(i), v_pk_dts(i)) || ');');
                            END LOOP;
                            ap('    l_pk := v_pk_obj.to_string;');
                        END IF;
                        ap('');

                        ap('    v_audit_json := JSON_OBJECT_T();');
                        ap('    v_cols_arr   := JSON_ARRAY_T();');
                        ap('    v_old_row    := JSON_OBJECT_T();');
                        ap('    v_new_row    := JSON_OBJECT_T();');
                        ap('    v_audit_json.put(''pk_value'', l_pk);');
                        ap('    v_audit_json.put(''transaction_id'', l_txn_id);');
                        ap('    v_audit_json.put(''table_name'', ' || v_table_lit || ');');
                        ap('    v_audit_json.put(''transaction_type'', l_action);');
                        ap('    v_audit_json.put(''user_name'', NVL(sys_context(''APEX$SESSION'',''APP_USER''), USER));');
                        ap('');

                        -- Per column: row snapshots and column-level changes
                        -- (supported columns only, excluding ignored)
                        FOR c IN (
                            SELECT column_name, data_type
                            FROM user_tab_columns
                            WHERE table_name = v_table_name
                            ORDER BY column_id
                        ) LOOP
                            IF NOT supported_datatype(c.data_type) THEN
                                CONTINUE;
                            END IF;
                            -- Excluded columns are never read: not in the changes, not in
                            -- the snapshots
                            IF v_excluded IS NOT NULL AND in_list(v_excluded, c.column_name) THEN
                                CONTINUE;
                            END IF;
                            -- Ignored columns are left out of the changes but kept in the row
                            -- snapshots: restore needs the whole row (e.g. a NOT NULL CREATED)
                            v_track := NOT is_ignored_column(c.column_name, v_ignored);

                            ap('    -- ' || c.column_name);
                            IF UPPER(c.data_type) = 'CLOB' THEN
                                -- An unchanged CLOB is left out of UPDATE snapshots; restore
                                -- then leaves it as it is
                                ap('    IF DELETING OR (UPDATING AND ' || changed_predicate(c.column_name, c.data_type) || ') THEN');
                                ap('        v_old_row.put(' || lit(c.column_name) || ', :OLD.' || q(c.column_name) || ');');
                                ap('    END IF;');
                                ap('    IF INSERTING OR (UPDATING AND ' || changed_predicate(c.column_name, c.data_type) || ') THEN');
                                ap('        v_new_row.put(' || lit(c.column_name) || ', :NEW.' || q(c.column_name) || ');');
                                ap('    END IF;');
                            ELSE
                                ap('    IF NOT INSERTING THEN');
                                ap('        v_old_row.put(' || lit(c.column_name) || ', ' ||
                                   to_char_expr(':OLD.' || q(c.column_name), c.data_type) || ');');
                                ap('    END IF;');
                                ap('    IF NOT DELETING THEN');
                                ap('        v_new_row.put(' || lit(c.column_name) || ', ' ||
                                   to_char_expr(':NEW.' || q(c.column_name), c.data_type) || ');');
                                ap('    END IF;');
                            END IF;

                            IF NOT v_track THEN
                                ap('');
                                CONTINUE;
                            END IF;
                            v_has_cols := TRUE;

                            -- A NULL inserted or deleted is not a change, so it gets no row
                            -- (the snapshot still has the column)
                            ap('    IF (INSERTING AND :NEW.' || q(c.column_name) || ' IS NOT NULL)' ||
                               ' OR (DELETING AND :OLD.' || q(c.column_name) || ' IS NOT NULL)' ||
                               ' OR (UPDATING AND ' || changed_predicate(c.column_name, c.data_type) || ') THEN');
                            ap('        l_has_changes := TRUE;');
                            ap('        v_col_obj := JSON_OBJECT_T();');
                            ap('        v_col_obj.put(''column_name'', ' || lit(c.column_name) || ');');
                            ap('        v_col_obj.put(''data_type'', ' || lit(UPPER(c.data_type)) || ');');
                            ap('        v_col_obj.put(''old_value'', CASE WHEN INSERTING THEN NULL ELSE ' ||
                               to_char_expr(':OLD.' || q(c.column_name), c.data_type) || ' END);');
                            ap('        v_col_obj.put(''new_value'', CASE WHEN DELETING THEN NULL ELSE ' ||
                               to_char_expr(':NEW.' || q(c.column_name), c.data_type) || ' END);');
                            ap('        v_cols_arr.append(v_col_obj);');
                            ap('    END IF;');
                            ap('');
                        END LOOP;

                        -- An INSERT or DELETE is always recorded, even with no non-NULL column
                        ap('    IF UPDATING AND NOT l_has_changes THEN');
                        ap('        RETURN;');
                        ap('    END IF;');
                        ap('');
                        ap('    v_audit_json.put(''old_row'', v_old_row);');
                        ap('    v_audit_json.put(''new_row'', v_new_row);');
                        ap('    v_audit_json.put(''columns'', v_cols_arr);');
                        ap('');
                        ap('    -- Write audit');
                        ap('    util_audit.capture_audit(v_audit_json);');
                        ap('');
                        ap('EXCEPTION');
                        ap('    WHEN OTHERS THEN');
                        ap('        -- Do not break business DML; record the failure instead');
                        ap('        l_err_code  := SQLCODE;');
                        ap('        l_err_msg   := SUBSTRB(SQLERRM, 1, 4000);');
                        ap('        l_err_trace := SUBSTRB(DBMS_UTILITY.FORMAT_ERROR_BACKTRACE, 1, 4000);');
                        ap('        BEGIN');
                        ap('            util_audit.log_error(' || v_table_lit || ', l_action, l_pk,');
                        ap('                l_err_code, l_err_msg, l_err_trace);');
                        ap('        EXCEPTION');
                        ap('            WHEN OTHERS THEN');
                        ap('                log_direct;');
                        ap('        END;');
                        ap('END;');

                        IF NOT v_has_cols THEN
                            RAISE_APPLICATION_ERROR(-20003, 'No auditable columns found for table: ' || v_table_name);
                        END IF;

                        RETURN v_sql;
                    END get_trigger_ddl;

                    --------------------------------------------------------------------------
                    -- Public: Create trigger
                    --------------------------------------------------------------------------
                    PROCEDURE create_audit_trigger(
                        p_table_name IN VARCHAR2,
                        p_action     IN VARCHAR2 DEFAULT 'EXECUTE'
                    ) IS
                        v_table_name VARCHAR2(128) := norm_name(p_table_name);
                        v_trg_name   VARCHAR2(128) := trig_name(p_table_name);
                        v_sql        CLOB          := get_trigger_ddl(p_table_name);
                        v_error      VARCHAR2(4000);
                    BEGIN
                        IF norm_name(p_action) = 'GENERATE' THEN
                            exec_sql(v_sql, p_action);
                            report_child_tables(v_table_name);
                            RETURN;
                        END IF;

                        -- Register first: the trigger DDL commits, which also saves this row.
                        -- An existing flag is kept, so regenerating a trigger (e.g. after
                        -- ALTER TABLE) does not re-enable a disabled table.
                        MERGE INTO util_audit_config c
                        USING (SELECT v_table_name table_name FROM dual) src
                        ON (c.table_name = src.table_name)
                        WHEN NOT MATCHED THEN
                            INSERT (table_name, enabled_flag, created_on, created_by)
                            VALUES (src.table_name, 'Y', SYSDATE, USER);

                        -- Create it disabled and enable it only when it compiled: an invalid
                        -- enabled trigger would block every change to the table
                        v_sql := REPLACE(v_sql, 'FOR EACH ROW' || CHR(10), 'FOR EACH ROW' || CHR(10) || 'DISABLE' || CHR(10));
                        BEGIN
                            exec_sql(v_sql, p_action);
                        EXCEPTION
                            WHEN OTHERS THEN
                                IF SQLCODE <> -24344 THEN  -- created with compilation errors
                                    RAISE;
                                END IF;
                        END;
                        SELECT MIN(text) INTO v_error
                        FROM user_errors
                        WHERE name = v_trg_name AND type = 'TRIGGER' AND attribute = 'ERROR';
                        IF v_error IS NOT NULL THEN
                            RAISE_APPLICATION_ERROR(-20006, 'The audit trigger for ' || v_table_name ||
                                ' did not compile, so it was left disabled: ' || v_error);
                        END IF;
                        exec_sql('ALTER TRIGGER ' || q(v_trg_name) || ' ENABLE', p_action);

                        -- Then remove any other trigger on the table that calls util_audit
                        -- (an older name, or a util_audit v1 AIUD_<table>_AUD trigger), so
                        -- rows are not audited twice. Creating first leaves no gap.
                        FOR t IN (
                            SELECT trigger_name
                            FROM v_util_audit_triggers
                            WHERE table_name = v_table_name
                              AND trigger_name <> v_trg_name
                        ) LOOP
                            exec_sql('DROP TRIGGER ' || q(t.trigger_name), p_action);
                        END LOOP;

                        report_child_tables(v_table_name);
                    END create_audit_trigger;

                    --------------------------------------------------------------------------
                    -- Public: Per-table excluded columns
                    --------------------------------------------------------------------------
                    -- The list, upper case, checked against the table: a misspelt name
                    -- would leave the real column audited without anyone noticing
                    FUNCTION checked_columns(p_table_name IN VARCHAR2, p_columns IN VARCHAR2) RETURN VARCHAR2 IS
                        v_columns VARCHAR2(4000) := UPPER(REPLACE(TRIM(BOTH ',' FROM REPLACE(p_columns, ' ')), ',,', ','));
                        v_col     VARCHAR2(4000);
                        v_cnt     NUMBER;
                        i         PLS_INTEGER := 1;
                    BEGIN
                        LOOP
                            v_col := REGEXP_SUBSTR(v_columns, '[^,]+', 1, i);
                            EXIT WHEN v_col IS NULL;
                            SELECT COUNT(*) INTO v_cnt FROM user_tab_columns
                             WHERE table_name = p_table_name AND column_name = v_col;
                            IF v_cnt = 0 THEN
                                RAISE_APPLICATION_ERROR(-20007, p_table_name || ' has no column ' || v_col || '.');
                            END IF;
                            i := i + 1;
                        END LOOP;
                        RETURN v_columns;
                    END;

                    PROCEDURE scrub_columns(
                        p_table_name IN VARCHAR2,
                        p_columns    IN VARCHAR2
                    ) IS
                        v_table_name VARCHAR2(128)  := norm_name(p_table_name);
                        v_columns    VARCHAR2(4000) := checked_columns(v_table_name, p_columns);
                        v_col        VARCHAR2(4000);
                        v_patch      VARCHAR2(4000);
                        v_events     NUMBER;
                        i            PLS_INTEGER := 1;
                    BEGIN
                        LOOP
                            v_col := REGEXP_SUBSTR(v_columns, '[^,]+', 1, i);
                            EXIT WHEN v_col IS NULL;
                            -- {"COL":null}: JSON_MERGEPATCH removes the key
                            SELECT JSON_OBJECT(KEY v_col VALUE NULL NULL ON NULL) INTO v_patch FROM dual;
                            UPDATE util_audit_txn
                               SET old_row_json = JSON_MERGEPATCH(old_row_json, v_patch RETURNING CLOB),
                                   new_row_json = JSON_MERGEPATCH(new_row_json, v_patch RETURNING CLOB)
                             WHERE table_name = v_table_name
                               AND (old_row_json IS NOT NULL OR new_row_json IS NOT NULL);
                            v_events := SQL%ROWCOUNT;
                            DELETE FROM util_audit_records
                             WHERE table_name = v_table_name AND column_name = v_col;
                            DBMS_OUTPUT.PUT_LINE('Removed ' || v_col || ' from ' || v_events || ' snapshot(s) and ' ||
                                                 SQL%ROWCOUNT || ' column change(s) of ' || v_table_name || '.');
                            i := i + 1;
                        END LOOP;
                    END scrub_columns;

                    PROCEDURE set_table_excluded_columns(
                        p_table_name    IN VARCHAR2,
                        p_columns       IN VARCHAR2,
                        p_regenerate    IN BOOLEAN DEFAULT TRUE,
                        p_scrub_history IN BOOLEAN DEFAULT FALSE
                    ) IS
                        v_table_name VARCHAR2(128)  := norm_name(p_table_name);
                        v_columns    VARCHAR2(4000) := checked_columns(v_table_name, p_columns);
                        v_has_trg    NUMBER;
                    BEGIN
                        -- The key identifies the row in every event; it has to be recorded
                        FOR k IN (
                            SELECT cols.column_name
                            FROM user_constraints cons
                            JOIN user_cons_columns cols ON cols.constraint_name = cons.constraint_name
                            WHERE cons.table_name = v_table_name AND cons.constraint_type = 'P'
                        ) LOOP
                            IF in_list(v_columns, k.column_name) THEN
                                RAISE_APPLICATION_ERROR(-20008, k.column_name || ' is part of the primary key of ' ||
                                    v_table_name || ' and cannot be excluded.');
                            END IF;
                        END LOOP;

                        MERGE INTO util_audit_config c
                        USING (SELECT v_table_name table_name FROM dual) src
                        ON (c.table_name = src.table_name)
                        WHEN MATCHED THEN
                            UPDATE SET excluded_columns = v_columns
                        WHEN NOT MATCHED THEN
                            INSERT (table_name, enabled_flag, created_on, created_by, excluded_columns)
                            VALUES (src.table_name, 'Y', SYSDATE, USER, v_columns);

                        IF p_regenerate THEN
                            SELECT COUNT(*) INTO v_has_trg
                            FROM v_util_audit_triggers
                            WHERE table_name = v_table_name;
                            IF v_has_trg > 0 THEN
                                create_audit_trigger(v_table_name);
                            END IF;
                        END IF;

                        IF p_scrub_history AND v_columns IS NOT NULL THEN
                            scrub_columns(v_table_name, v_columns);
                        END IF;
                    END set_table_excluded_columns;

                    --------------------------------------------------------------------------
                    -- Public: Per-table ignored columns
                    --------------------------------------------------------------------------
                    PROCEDURE set_table_ignored_columns(
                        p_table_name IN VARCHAR2,
                        p_columns    IN VARCHAR2,
                        p_regenerate IN BOOLEAN DEFAULT TRUE
                    ) IS
                        v_table_name VARCHAR2(128)  := norm_name(p_table_name);
                        v_columns    VARCHAR2(4000) := UPPER(REPLACE(TRIM(BOTH ',' FROM REPLACE(p_columns, ' ')), ',,', ','));
                        v_has_trg    NUMBER;
                    BEGIN
                        MERGE INTO util_audit_config c
                        USING (SELECT v_table_name table_name FROM dual) src
                        ON (c.table_name = src.table_name)
                        WHEN MATCHED THEN
                            UPDATE SET ignored_columns = v_columns
                        WHEN NOT MATCHED THEN
                            INSERT (table_name, enabled_flag, created_on, created_by, ignored_columns)
                            VALUES (src.table_name, 'Y', SYSDATE, USER, v_columns);

                        IF p_regenerate THEN
                            SELECT COUNT(*) INTO v_has_trg
                            FROM v_util_audit_triggers
                            WHERE table_name = v_table_name;
                            IF v_has_trg > 0 THEN
                                create_audit_trigger(v_table_name);
                            END IF;
                        END IF;
                    END set_table_ignored_columns;

                    --------------------------------------------------------------------------
                    -- Public: Re-create all triggers
                    --------------------------------------------------------------------------
                    PROCEDURE recreate_all_triggers IS
                        v_failed PLS_INTEGER := 0;
                    BEGIN
                        FOR t IN (
                            SELECT DISTINCT table_name
                            FROM v_util_audit_triggers
                            WHERE table_name IN (SELECT table_name FROM util_audit_config)
                            ORDER BY table_name
                        ) LOOP
                            BEGIN
                                create_audit_trigger(t.table_name);
                                DBMS_OUTPUT.PUT_LINE('Re-created trigger for ' || t.table_name);
                            EXCEPTION
                                WHEN OTHERS THEN
                                    v_failed := v_failed + 1;
                                    DBMS_OUTPUT.PUT_LINE('FAILED for ' || t.table_name || ': ' || SQLERRM);
                            END;
                        END LOOP;

                        IF v_failed > 0 THEN
                            RAISE_APPLICATION_ERROR(-20004, v_failed || ' trigger(s) could not be re-created. See the output for details.');
                        END IF;
                    END recreate_all_triggers;

                END util_audit_gen;
                /
                ```
        }
    )

    installScript install-util-audit-query-spec (
        execution {
            sequence: 90
        }
        script {
            content:
                ```
                -- Package util_audit_query (generated from setup.sql by tools/sync_supporting_objects.py)
                -- util_audit v1 guard
                DECLARE
                    l_v1 NUMBER;
                BEGIN
                    SELECT COUNT(*)
                      INTO l_v1
                      FROM user_tables t
                     WHERE t.table_name = 'UTIL_AUDIT_RECORDS'
                       AND NOT EXISTS (SELECT 1 FROM user_tab_columns c
                                        WHERE c.table_name = t.table_name
                                          AND c.column_name = 'PK_VALUE_VC');
                    IF l_v1 > 0 THEN
                        RAISE_APPLICATION_ERROR(-20100,
                            'This schema has util_audit v1 (UTIL_AUDIT_RECORDS without PK_VALUE_VC). ' ||
                            'Installing over it would break the v1 audit triggers, so nothing was changed. ' ||
                            'Run migrate_v1.sql instead (see docs/migrating-from-v1.md).');
                    END IF;
                END;
                /
                create or replace PACKAGE util_audit_query AS
                    ------------------------------------------------------------------------------
                    -- util_audit_query
                    --
                    -- Builds the query for an "audit history" region in another APEX app: the
                    -- changes recorded for the row a page is showing, found by that page's
                    -- primary key items.
                    --
                    --   p_table_name     audited table the page edits
                    --   p_key_items      page items holding the primary key, comma-separated,
                    --                    in key column order. Default: P<p_page_id>_<column>.
                    --   p_page_id        page number in the other app (used for the default)
                    --   p_style          COLUMNS: one row per changed column, old and new value
                    --                    EVENTS:  one row per change, listing changed columns
                    --   p_columns        only show these columns (comma-separated). Null = all
                    --   p_child_tables   also show changes to rows of these audited child
                    --                    tables that point at this row (comma-separated)
                    --   p_schema         schema that owns util_audit, when the other app parses
                    --                    as a different schema. Null = same schema
                    --   p_friendly_names Y: "Hire Date" instead of HIRE_DATE
                    --
                    -- Result columns: CHANGED_AT, CHANGED_BY, ACTION, [TABLE_NAME, RECORD_KEY
                    -- when child tables are included], then FIELD, OLD_VALUE, NEW_VALUE
                    -- (COLUMNS) or FIELDS_CHANGED (EVENTS). Newest first.
                    --
                    -- util_audit_apx writes the same region as APEXlang source.
                    ------------------------------------------------------------------------------

                    FUNCTION get_history_query(
                        p_table_name     IN VARCHAR2,
                        p_key_items      IN VARCHAR2 DEFAULT NULL,
                        p_page_id        IN NUMBER   DEFAULT NULL,
                        p_style          IN VARCHAR2 DEFAULT 'COLUMNS',
                        p_columns        IN VARCHAR2 DEFAULT NULL,
                        p_child_tables   IN VARCHAR2 DEFAULT NULL,
                        p_schema         IN VARCHAR2 DEFAULT NULL,
                        p_friendly_names IN VARCHAR2 DEFAULT 'Y'
                    ) RETURN CLOB;

                    -- The page items the region must submit, comma-separated
                    FUNCTION get_key_items(
                        p_table_name IN VARCHAR2,
                        p_key_items  IN VARCHAR2 DEFAULT NULL,
                        p_page_id    IN NUMBER   DEFAULT NULL
                    ) RETURN VARCHAR2;

                    -- The same query keyed on one bind, :SAMPLE_KEY, holding a PK_VALUE_VC
                    -- value. Used to preview the result for an existing row.
                    FUNCTION get_preview_query(
                        p_table_name     IN VARCHAR2,
                        p_style          IN VARCHAR2 DEFAULT 'COLUMNS',
                        p_columns        IN VARCHAR2 DEFAULT NULL,
                        p_child_tables   IN VARCHAR2 DEFAULT NULL,
                        p_friendly_names IN VARCHAR2 DEFAULT 'Y'
                    ) RETURN CLOB;

                    -- One row of history(). A package type, so installing needs no
                    -- CREATE TYPE privilege.
                    TYPE t_history_row IS RECORD (
                        changed_at     TIMESTAMP(6),
                        changed_by     VARCHAR2(255),
                        action         VARCHAR2(6),
                        table_name     VARCHAR2(255),
                        record_key     VARCHAR2(4000),
                        field          VARCHAR2(255),
                        old_value      VARCHAR2(4000),
                        new_value      VARCHAR2(4000),
                        fields_changed VARCHAR2(4000),
                        transaction_id VARCHAR2(64)
                    );
                    TYPE t_history_tab IS TABLE OF t_history_row;

                    -- The history as rows, for any region type:
                    --   select * from table(util_audit_query.history('EMP', :P10_EMP_ID))
                    -- p_key1 .. p_key4 are the key column values, in key column order.
                    -- COLUMNS fills FIELD, OLD_VALUE, NEW_VALUE; EVENTS fills FIELDS_CHANGED.
                    -- TABLE_NAME and RECORD_KEY tell rows of child tables apart.
                    FUNCTION history(
                        p_table_name     IN VARCHAR2,
                        p_key1           IN VARCHAR2,
                        p_key2           IN VARCHAR2 DEFAULT NULL,
                        p_key3           IN VARCHAR2 DEFAULT NULL,
                        p_key4           IN VARCHAR2 DEFAULT NULL,
                        p_style          IN VARCHAR2 DEFAULT 'COLUMNS',
                        p_columns        IN VARCHAR2 DEFAULT NULL,
                        p_child_tables   IN VARCHAR2 DEFAULT NULL,
                        p_friendly_names IN VARCHAR2 DEFAULT 'Y',
                        p_max_rows       IN NUMBER   DEFAULT NULL
                    ) RETURN t_history_tab PIPELINED;

                    -- SQL for a region that reads history(): short, and follows util_audit
                    -- upgrades without being regenerated
                    FUNCTION get_history_function_query(
                        p_table_name     IN VARCHAR2,
                        p_key_items      IN VARCHAR2 DEFAULT NULL,
                        p_page_id        IN NUMBER   DEFAULT NULL,
                        p_style          IN VARCHAR2 DEFAULT 'COLUMNS',
                        p_columns        IN VARCHAR2 DEFAULT NULL,
                        p_child_tables   IN VARCHAR2 DEFAULT NULL,
                        p_schema         IN VARCHAR2 DEFAULT NULL,
                        p_friendly_names IN VARCHAR2 DEFAULT 'Y'
                    ) RETURN CLOB;

                END util_audit_query;
                /
                ```
        }
    )

    installScript install-util-audit-query-body (
        execution {
            sequence: 100
        }
        script {
            content:
                ```
                -- Package body util_audit_query (generated from setup.sql by tools/sync_supporting_objects.py)
                -- util_audit v1 guard
                DECLARE
                    l_v1 NUMBER;
                BEGIN
                    SELECT COUNT(*)
                      INTO l_v1
                      FROM user_tables t
                     WHERE t.table_name = 'UTIL_AUDIT_RECORDS'
                       AND NOT EXISTS (SELECT 1 FROM user_tab_columns c
                                        WHERE c.table_name = t.table_name
                                          AND c.column_name = 'PK_VALUE_VC');
                    IF l_v1 > 0 THEN
                        RAISE_APPLICATION_ERROR(-20100,
                            'This schema has util_audit v1 (UTIL_AUDIT_RECORDS without PK_VALUE_VC). ' ||
                            'Installing over it would break the v1 audit triggers, so nothing was changed. ' ||
                            'Run migrate_v1.sql instead (see docs/migrating-from-v1.md).');
                    END IF;
                END;
                /
                create or replace PACKAGE BODY util_audit_query AS

                    TYPE t_names IS TABLE OF VARCHAR2(128) INDEX BY PLS_INTEGER;
                    TYPE t_exprs IS TABLE OF VARCHAR2(4000) INDEX BY PLS_INTEGER;

                    c_name_pattern CONSTANT VARCHAR2(40) := '^[A-Za-z][A-Za-z0-9_$#]*$';

                    FUNCTION lit(p_text IN VARCHAR2) RETURN VARCHAR2 IS
                    BEGIN
                        RETURN '''' || REPLACE(p_text, '''', '''''') || '''';
                    END;

                    -- JSON path for a column of a row snapshot, quoted so any name works
                    FUNCTION jpath(p_column IN VARCHAR2) RETURN VARCHAR2 IS
                    BEGIN
                        RETURN lit('$."' || p_column || '"');
                    END;

                    -- Comma- or colon-separated list, trimmed, empty entries dropped.
                    -- Line breaks and other control characters separate entries too.
                    FUNCTION split(p_list IN VARCHAR2, p_upper IN BOOLEAN DEFAULT TRUE) RETURN t_names IS
                        l_out  t_names;
                        l_item VARCHAR2(4000);
                        i      PLS_INTEGER := 1;
                    BEGIN
                        LOOP
                            l_item := REGEXP_SUBSTR(p_list, '[^,:[:cntrl:]]+', 1, i);
                            EXIT WHEN l_item IS NULL;
                            l_item := TRIM(l_item);
                            IF l_item IS NOT NULL THEN
                                l_out(l_out.COUNT + 1) := CASE WHEN p_upper THEN UPPER(l_item) ELSE l_item END;
                            END IF;
                            i := i + 1;
                        END LOOP;
                        RETURN l_out;
                    END;

                    FUNCTION in_names(p_names IN t_names) RETURN VARCHAR2 IS
                        l_out VARCHAR2(32767);
                    BEGIN
                        FOR i IN 1 .. p_names.COUNT LOOP
                            l_out := l_out || CASE WHEN i > 1 THEN ', ' END || lit(p_names(i));
                        END LOOP;
                        RETURN '(' || l_out || ')';
                    END;

                    FUNCTION pk_columns(p_table_name IN VARCHAR2) RETURN t_names IS
                        l_cols t_names;
                    BEGIN
                        SELECT cols.column_name
                        BULK COLLECT INTO l_cols
                        FROM user_constraints cons
                        JOIN user_cons_columns cols
                          ON cols.constraint_name = cons.constraint_name
                        WHERE cons.table_name = p_table_name
                          AND cons.constraint_type = 'P'
                        ORDER BY cols.position;

                        IF l_cols.COUNT = 0 THEN
                            RAISE_APPLICATION_ERROR(-20020, p_table_name || ' has no primary key.');
                        END IF;
                        RETURN l_cols;
                    END;

                    FUNCTION norm_table(p_table_name IN VARCHAR2) RETURN VARCHAR2 IS
                        l_table VARCHAR2(128) := UPPER(TRIM(p_table_name));
                        l_cnt   NUMBER;
                    BEGIN
                        SELECT COUNT(*) INTO l_cnt FROM user_tables WHERE table_name = l_table;
                        IF l_cnt = 0 THEN
                            RAISE_APPLICATION_ERROR(-20023, 'Table not found in schema: ' || l_table);
                        END IF;
                        RETURN l_table;
                    END;

                    FUNCTION resolve_items(
                        p_table_name IN VARCHAR2,
                        p_key_items  IN VARCHAR2,
                        p_page_id    IN NUMBER
                    ) RETURN t_names IS
                        l_pk    t_names := pk_columns(p_table_name);
                        l_items t_names;
                    BEGIN
                        IF p_key_items IS NOT NULL THEN
                            l_items := split(p_key_items);
                            IF l_items.COUNT <> l_pk.COUNT THEN
                                RAISE_APPLICATION_ERROR(-20021, p_table_name || ' has ' || l_pk.COUNT ||
                                    ' key column(s), so give ' || l_pk.COUNT || ' page item(s), in this order: ' ||
                                    REPLACE(in_names(l_pk), '''', ''));
                            END IF;
                        ELSIF p_page_id IS NULL THEN
                            RAISE_APPLICATION_ERROR(-20022, 'Give the page number, or the page items that hold the key.');
                        ELSE
                            FOR i IN 1 .. l_pk.COUNT LOOP
                                l_items(i) := 'P' || p_page_id || '_' || l_pk(i);
                            END LOOP;
                        END IF;

                        FOR i IN 1 .. l_items.COUNT LOOP
                            IF NOT REGEXP_LIKE(l_items(i), c_name_pattern) THEN
                                RAISE_APPLICATION_ERROR(-20024, 'Not a valid page item name: ' || l_items(i));
                            END IF;
                        END LOOP;
                        RETURN l_items;
                    END;

                    -- The expression that equals PK_VALUE_VC for the row: the single key
                    -- value, or the key object the trigger writes for a composite key
                    FUNCTION key_expr(p_pk IN t_names, p_exprs IN t_exprs) RETURN VARCHAR2 IS
                        l_out VARCHAR2(32767);
                    BEGIN
                        IF p_pk.COUNT = 1 THEN
                            RETURN p_exprs(1);
                        END IF;
                        FOR i IN 1 .. p_pk.COUNT LOOP
                            l_out := l_out || CASE WHEN i > 1 THEN ', ' END || lit(p_pk(i)) || ' value ' || p_exprs(i);
                        END LOOP;
                        RETURN 'json_object(' || l_out || ')';
                    END;

                    FUNCTION build(
                        p_table_name     IN VARCHAR2,
                        p_exprs          IN t_exprs,
                        p_header         IN VARCHAR2,
                        p_style          IN VARCHAR2,
                        p_columns        IN VARCHAR2,
                        p_child_tables   IN VARCHAR2,
                        p_schema         IN VARCHAR2,
                        p_friendly_names IN VARCHAR2,
                        p_full_shape     IN BOOLEAN DEFAULT FALSE
                    ) RETURN CLOB IS
                        l_table    VARCHAR2(128) := norm_table(p_table_name);
                        l_style    VARCHAR2(10)  := NVL(UPPER(p_style), 'COLUMNS');
                        l_pk       t_names       := pk_columns(l_table);
                        l_cols     t_names       := split(p_columns);
                        l_children t_names       := split(p_child_tables);
                        l_pfx      VARCHAR2(200);
                        a          VARCHAR2(1);
                        l_field    VARCHAR2(200);
                        l_where    CLOB;
                        l_notes    VARCHAR2(4000);
                        l_sql      CLOB;
                        l_cnt      NUMBER;
                        l_fk_conds VARCHAR2(32767);

                        FUNCTION field_of(p_alias IN VARCHAR2) RETURN VARCHAR2 IS
                        BEGIN
                            RETURN CASE WHEN NVL(p_friendly_names, 'Y') = 'Y'
                                        THEN 'initcap(replace(' || p_alias || '.column_name, ''_'', '' ''))'
                                        ELSE p_alias || '.column_name' END;
                        END;
                    BEGIN
                        IF l_style NOT IN ('COLUMNS', 'EVENTS') THEN
                            RAISE_APPLICATION_ERROR(-20025, 'Style must be COLUMNS or EVENTS.');
                        END IF;
                        IF p_schema IS NOT NULL THEN
                            IF NOT REGEXP_LIKE(TRIM(p_schema), c_name_pattern) THEN
                                RAISE_APPLICATION_ERROR(-20026, 'Not a valid schema name: ' || p_schema);
                            END IF;
                            l_pfx := UPPER(TRIM(p_schema)) || '.';
                        END IF;
                        a := CASE l_style WHEN 'COLUMNS' THEN 'h' ELSE 'e' END;
                        l_field := field_of('r');

                        FOR i IN 1 .. l_cols.COUNT LOOP
                            SELECT COUNT(*) INTO l_cnt FROM user_tab_columns
                            WHERE table_name = l_table AND column_name = l_cols(i);
                            IF l_cnt = 0 THEN
                                RAISE_APPLICATION_ERROR(-20027, l_table || ' has no column ' || l_cols(i) || '.');
                            END IF;
                        END LOOP;

                        -- This row
                        l_where := '(' || a || '.table_name = ' || lit(l_table) ||
                                   ' and ' || a || '.pk_value_vc = ' || key_expr(l_pk, p_exprs);
                        IF l_cols.COUNT > 0 THEN
                            IF l_style = 'COLUMNS' THEN
                                l_where := l_where || CHR(10) || '          and h.column_name in ' || in_names(l_cols);
                            ELSE
                                l_where := l_where || CHR(10) || '          and exists (select 1 from ' || l_pfx ||
                                           'util_audit_records r where r.transaction_id = e.transaction_id and r.column_name in ' ||
                                           in_names(l_cols) || ')';
                            END IF;
                        END IF;
                        l_where := l_where || ')';

                        -- Child rows: their row snapshot holds a foreign key value equal to
                        -- this row's key, before or after the change
                        FOR c IN 1 .. l_children.COUNT LOOP
                            l_fk_conds := NULL;
                            FOR fk IN (
                                SELECT constraint_name
                                FROM v_util_audit_child_tables
                                WHERE parent_table = l_table
                                  AND child_table  = l_children(c)
                                ORDER BY constraint_name
                            ) LOOP
                                DECLARE
                                    l_old  VARCHAR2(4000);
                                    l_new  VARCHAR2(4000);
                                    l_idx  PLS_INTEGER;
                                    l_skip BOOLEAN := FALSE;
                                BEGIN
                                    FOR p IN (
                                        SELECT cc.column_name child_col, pc.column_name parent_col
                                        FROM user_constraints uc
                                        JOIN user_cons_columns cc ON cc.constraint_name = uc.constraint_name
                                        JOIN user_cons_columns pc ON pc.constraint_name = uc.r_constraint_name
                                                                 AND pc.position = cc.position
                                        WHERE uc.constraint_name = fk.constraint_name
                                        ORDER BY cc.position
                                    ) LOOP
                                        l_idx := NULL;
                                        FOR k IN 1 .. l_pk.COUNT LOOP
                                            IF l_pk(k) = p.parent_col THEN l_idx := k; END IF;
                                        END LOOP;
                                        IF l_idx IS NULL THEN
                                            l_skip := TRUE;
                                            EXIT;
                                        END IF;
                                        l_old := l_old || CASE WHEN l_old IS NOT NULL THEN ' and ' END ||
                                                 'json_value(' || a || '.old_row_json, ' || jpath(p.child_col) || ') = ' || p_exprs(l_idx);
                                        l_new := l_new || CASE WHEN l_new IS NOT NULL THEN ' and ' END ||
                                                 'json_value(' || a || '.new_row_json, ' || jpath(p.child_col) || ') = ' || p_exprs(l_idx);
                                    END LOOP;
                                    IF l_skip THEN
                                        l_notes := l_notes || '-- ' || l_children(c) || ' (' || fk.constraint_name ||
                                                   ') skipped: it references a unique key, not the primary key' || CHR(10);
                                    ELSE
                                        l_fk_conds := l_fk_conds || CASE WHEN l_fk_conds IS NOT NULL THEN CHR(10) || '             or ' END ||
                                                      '(' || l_old || ')' || CHR(10) || '             or (' || l_new || ')';
                                    END IF;
                                END;
                            END LOOP;

                            IF l_fk_conds IS NULL THEN
                                IF l_notes IS NULL OR INSTR(l_notes, '-- ' || l_children(c) || ' (') = 0 THEN
                                    RAISE_APPLICATION_ERROR(-20028, l_children(c) || ' does not reference ' || l_table || '.');
                                END IF;
                            ELSE
                                l_where := l_where || CHR(10) || '    or (' || a || '.table_name = ' || lit(l_children(c)) ||
                                           CHR(10) || '        and (' || l_fk_conds || '))';
                            END IF;
                        END LOOP;

                        l_sql := p_header || l_notes;
                        IF l_style = 'COLUMNS' THEN
                            l_sql := l_sql ||
                                'select h.audit_ts as changed_at,' || CHR(10) ||
                                '       h.username as changed_by,' || CHR(10) ||
                                '       h.transaction_type as action,' || CHR(10) ||
                                CASE WHEN l_children.COUNT > 0 OR p_full_shape THEN
                                '       h.table_name as table_name,' || CHR(10) ||
                                '       h.pk_value_vc as record_key,' || CHR(10) END ||
                                '       ' || field_of('h') || ' as field,' || CHR(10) ||
                                '       coalesce(h.old_value, dbms_lob.substr(h.old_clob, 1000, 1)) as old_value,' || CHR(10) ||
                                '       coalesce(h.new_value, dbms_lob.substr(h.new_clob, 1000, 1)) as new_value' ||
                                CASE WHEN p_full_shape THEN ',' || CHR(10) ||
                                '       cast(null as varchar2(4000)) as fields_changed,' || CHR(10) ||
                                '       h.transaction_id as transaction_id' END || CHR(10) ||
                                '  from ' || l_pfx || 'v_util_audit_row_history h' || CHR(10) ||
                                ' where ' || l_where || CHR(10) ||
                                ' order by h.audit_ts desc, h.transaction_id, h.column_name';
                        ELSE
                            l_sql := l_sql ||
                                'select e.audit_ts as changed_at,' || CHR(10) ||
                                '       e.username as changed_by,' || CHR(10) ||
                                '       e.transaction_type as action,' || CHR(10) ||
                                CASE WHEN l_children.COUNT > 0 OR p_full_shape THEN
                                '       e.table_name as table_name,' || CHR(10) ||
                                '       e.pk_value_vc as record_key,' || CHR(10) END ||
                                CASE WHEN p_full_shape THEN
                                '       cast(null as varchar2(255)) as field,' || CHR(10) ||
                                '       cast(null as varchar2(4000)) as old_value,' || CHR(10) ||
                                '       cast(null as varchar2(4000)) as new_value,' || CHR(10) END ||
                                '       (select listagg(' || l_field || ', '', '' on overflow truncate ''...'' with count)' || CHR(10) ||
                                '                 within group (order by r.column_name)' || CHR(10) ||
                                '          from ' || l_pfx || 'util_audit_records r' || CHR(10) ||
                                '         where r.transaction_id = e.transaction_id) as fields_changed' ||
                                CASE WHEN p_full_shape THEN ',' || CHR(10) ||
                                '       e.transaction_id as transaction_id' END || CHR(10) ||
                                '  from ' || l_pfx || 'v_util_audit_events e' || CHR(10) ||
                                ' where ' || l_where || CHR(10) ||
                                ' order by e.audit_ts desc, e.transaction_id';
                        END IF;
                        RETURN l_sql;
                    END build;

                    FUNCTION get_key_items(
                        p_table_name IN VARCHAR2,
                        p_key_items  IN VARCHAR2 DEFAULT NULL,
                        p_page_id    IN NUMBER   DEFAULT NULL
                    ) RETURN VARCHAR2 IS
                        l_items t_names := resolve_items(norm_table(p_table_name), p_key_items, p_page_id);
                        l_out   VARCHAR2(4000);
                    BEGIN
                        FOR i IN 1 .. l_items.COUNT LOOP
                            l_out := l_out || CASE WHEN i > 1 THEN ',' END || l_items(i);
                        END LOOP;
                        RETURN l_out;
                    END;

                    FUNCTION get_history_query(
                        p_table_name     IN VARCHAR2,
                        p_key_items      IN VARCHAR2 DEFAULT NULL,
                        p_page_id        IN NUMBER   DEFAULT NULL,
                        p_style          IN VARCHAR2 DEFAULT 'COLUMNS',
                        p_columns        IN VARCHAR2 DEFAULT NULL,
                        p_child_tables   IN VARCHAR2 DEFAULT NULL,
                        p_schema         IN VARCHAR2 DEFAULT NULL,
                        p_friendly_names IN VARCHAR2 DEFAULT 'Y'
                    ) RETURN CLOB IS
                        l_table VARCHAR2(128) := norm_table(p_table_name);
                        l_items t_names       := resolve_items(l_table, p_key_items, p_page_id);
                        l_exprs t_exprs;
                    BEGIN
                        FOR i IN 1 .. l_items.COUNT LOOP
                            l_exprs(i) := ':' || l_items(i);
                        END LOOP;
                        RETURN build(l_table, l_exprs,
                                     '-- Audit history for ' || l_table || ' (generated by util_audit_query)' || CHR(10) ||
                                     '-- Page Items to Submit: ' || get_key_items(l_table, p_key_items, p_page_id) || CHR(10),
                                     p_style, p_columns, p_child_tables, p_schema, p_friendly_names);
                    END;

                    FUNCTION get_preview_query(
                        p_table_name     IN VARCHAR2,
                        p_style          IN VARCHAR2 DEFAULT 'COLUMNS',
                        p_columns        IN VARCHAR2 DEFAULT NULL,
                        p_child_tables   IN VARCHAR2 DEFAULT NULL,
                        p_friendly_names IN VARCHAR2 DEFAULT 'Y'
                    ) RETURN CLOB IS
                        l_table VARCHAR2(128) := norm_table(p_table_name);
                        l_pk    t_names       := pk_columns(l_table);
                        l_exprs t_exprs;
                    BEGIN
                        -- :SAMPLE_KEY is a PK_VALUE_VC value; a composite one is a JSON object
                        FOR i IN 1 .. l_pk.COUNT LOOP
                            l_exprs(i) := CASE WHEN l_pk.COUNT = 1 THEN ':SAMPLE_KEY'
                                               ELSE 'json_value(:SAMPLE_KEY, ' || jpath(l_pk(i)) || ')' END;
                        END LOOP;
                        RETURN build(l_table, l_exprs, NULL, p_style, p_columns, p_child_tables, NULL, p_friendly_names);
                    END;

                    FUNCTION history(
                        p_table_name     IN VARCHAR2,
                        p_key1           IN VARCHAR2,
                        p_key2           IN VARCHAR2 DEFAULT NULL,
                        p_key3           IN VARCHAR2 DEFAULT NULL,
                        p_key4           IN VARCHAR2 DEFAULT NULL,
                        p_style          IN VARCHAR2 DEFAULT 'COLUMNS',
                        p_columns        IN VARCHAR2 DEFAULT NULL,
                        p_child_tables   IN VARCHAR2 DEFAULT NULL,
                        p_friendly_names IN VARCHAR2 DEFAULT 'Y',
                        p_max_rows       IN NUMBER   DEFAULT NULL
                    ) RETURN t_history_tab PIPELINED IS
                        l_table VARCHAR2(128);
                        l_pk    t_names;
                        l_exprs t_exprs;
                        l_keys  t_exprs;
                        l_key   VARCHAR2(4000);
                        l_obj   json_object_t;
                        l_cur   INTEGER;
                        l_rc    SYS_REFCURSOR;
                        l_count PLS_INTEGER := 0;
                        l_recs  t_history_tab;
                        l_sql   CLOB;
                    BEGIN
                        IF p_key1 IS NULL THEN
                            RETURN;
                        END IF;
                        l_table := norm_table(p_table_name);
                        l_pk    := pk_columns(l_table);
                        l_keys(1) := p_key1; l_keys(2) := p_key2; l_keys(3) := p_key3; l_keys(4) := p_key4;
                        IF l_pk.COUNT > 4 THEN
                            RAISE_APPLICATION_ERROR(-20030, l_table || ' has more than 4 key columns.');
                        END IF;

                        -- The key exactly as the trigger stores it in PK_VALUE_VC
                        IF l_pk.COUNT = 1 THEN
                            l_key := p_key1;
                        ELSE
                            l_obj := json_object_t();
                            FOR i IN 1 .. l_pk.COUNT LOOP
                                l_obj.put(l_pk(i), l_keys(i));
                            END LOOP;
                            l_key := l_obj.to_string;
                        END IF;

                        FOR i IN 1 .. l_pk.COUNT LOOP
                            l_exprs(i) := CASE WHEN l_pk.COUNT = 1 THEN ':SAMPLE_KEY'
                                               ELSE 'json_value(:SAMPLE_KEY, ' || jpath(l_pk(i)) || ')' END;
                        END LOOP;

                        l_sql := build(l_table, l_exprs, NULL, p_style, p_columns, p_child_tables,
                                       NULL, p_friendly_names, p_full_shape => TRUE);
                        l_cur := DBMS_SQL.OPEN_CURSOR;
                        DBMS_SQL.PARSE(l_cur, l_sql, DBMS_SQL.NATIVE);
                        DBMS_SQL.BIND_VARIABLE(l_cur, 'SAMPLE_KEY', l_key);
                        l_count := DBMS_SQL.EXECUTE(l_cur);
                        l_rc := DBMS_SQL.TO_REFCURSOR(l_cur);
                        l_cur := NULL;
                        l_count := 0;
                        LOOP
                            FETCH l_rc BULK COLLECT INTO l_recs LIMIT 200;
                            FOR i IN 1 .. l_recs.COUNT LOOP
                                EXIT WHEN p_max_rows IS NOT NULL AND l_count >= p_max_rows;
                                l_count := l_count + 1;
                                PIPE ROW (l_recs(i));
                            END LOOP;
                            EXIT WHEN l_recs.COUNT < 200 OR (p_max_rows IS NOT NULL AND l_count >= p_max_rows);
                        END LOOP;
                        CLOSE l_rc;
                        RETURN;
                    EXCEPTION
                        WHEN OTHERS THEN
                            -- Includes NO_DATA_NEEDED, when the caller stops fetching early
                            IF l_rc%ISOPEN THEN
                                CLOSE l_rc;
                            END IF;
                            IF l_cur IS NOT NULL AND DBMS_SQL.IS_OPEN(l_cur) THEN
                                DBMS_SQL.CLOSE_CURSOR(l_cur);
                            END IF;
                            RAISE;
                    END history;

                    FUNCTION get_history_function_query(
                        p_table_name     IN VARCHAR2,
                        p_key_items      IN VARCHAR2 DEFAULT NULL,
                        p_page_id        IN NUMBER   DEFAULT NULL,
                        p_style          IN VARCHAR2 DEFAULT 'COLUMNS',
                        p_columns        IN VARCHAR2 DEFAULT NULL,
                        p_child_tables   IN VARCHAR2 DEFAULT NULL,
                        p_schema         IN VARCHAR2 DEFAULT NULL,
                        p_friendly_names IN VARCHAR2 DEFAULT 'Y'
                    ) RETURN CLOB IS
                        l_table VARCHAR2(128) := norm_table(p_table_name);
                        l_items t_names       := resolve_items(l_table, p_key_items, p_page_id);
                        l_style VARCHAR2(10)  := NVL(UPPER(p_style), 'COLUMNS');
                        l_cols  t_names       := split(p_columns);
                        l_kids  t_names       := split(p_child_tables);
                        l_list  VARCHAR2(32767);
                        l_sql   VARCHAR2(32767);
                    BEGIN
                        IF l_items.COUNT > 4 THEN
                            RAISE_APPLICATION_ERROR(-20030, l_table || ' has more than 4 key columns.');
                        END IF;
                        -- Checks style, columns, child tables and schema; the query is not used
                        l_sql := get_history_query(p_table_name, p_key_items, p_page_id, p_style,
                                                   p_columns, p_child_tables, p_schema, p_friendly_names);

                        l_sql := '-- Audit history for ' || l_table || ' (generated by util_audit_query)' || CHR(10) ||
                                 '-- Page Items to Submit: ' || get_key_items(l_table, p_key_items, p_page_id) || CHR(10) ||
                                 'select changed_at,' || CHR(10) ||
                                 '       changed_by,' || CHR(10) ||
                                 '       action,' || CHR(10) ||
                                 CASE WHEN l_kids.COUNT > 0 THEN
                                 '       table_name,' || CHR(10) ||
                                 '       record_key,' || CHR(10) END ||
                                 CASE WHEN l_style = 'COLUMNS' THEN
                                 '       field,' || CHR(10) ||
                                 '       old_value,' || CHR(10) ||
                                 '       new_value' || CHR(10)
                                 ELSE
                                 '       fields_changed' || CHR(10) END ||
                                 '  from table(' ||
                                 CASE WHEN p_schema IS NOT NULL THEN UPPER(TRIM(p_schema)) || '.' END ||
                                 'util_audit_query.history(' || CHR(10) ||
                                 '           p_table_name => ' || lit(l_table);
                        FOR i IN 1 .. l_items.COUNT LOOP
                            l_sql := l_sql || ',' || CHR(10) || '           p_key' || i || '       => :' || l_items(i);
                        END LOOP;
                        IF l_style <> 'COLUMNS' THEN
                            l_sql := l_sql || ',' || CHR(10) || '           p_style      => ''EVENTS''';
                        END IF;
                        IF l_cols.COUNT > 0 THEN
                            FOR i IN 1 .. l_cols.COUNT LOOP
                                l_list := l_list || CASE WHEN i > 1 THEN ',' END || l_cols(i);
                            END LOOP;
                            l_sql := l_sql || ',' || CHR(10) || '           p_columns    => ' || lit(l_list);
                            l_list := NULL;
                        END IF;
                        IF l_kids.COUNT > 0 THEN
                            FOR i IN 1 .. l_kids.COUNT LOOP
                                l_list := l_list || CASE WHEN i > 1 THEN ',' END || l_kids(i);
                            END LOOP;
                            l_sql := l_sql || ',' || CHR(10) || '           p_child_tables => ' || lit(l_list);
                        END IF;
                        IF NVL(p_friendly_names, 'Y') <> 'Y' THEN
                            l_sql := l_sql || ',' || CHR(10) || '           p_friendly_names => ''N''';
                        END IF;
                        RETURN l_sql || '))';
                    END get_history_function_query;

                END util_audit_query;
                /
                ```
        }
    )

    installScript install-util-audit-apx-spec (

      "return": "COLUMN_NAME",
      "source": "USER_TAB_COLUMNS"
    },
    {
      "lov": "P6_PK_VALUE (page-local, cascading P6_TABLE_NAME)",
      "type": "dynamic",
      "display": "PK_VALUE_VC",
      "return": "PK_VALUE_VC",
      "source": "UTIL_AUDIT_TXN"
    }
  ],
  "behaviorPlan": {
    "modalTargets": "see compositionPlan.modalTargets",
    "pageActions": [
      {
        "page": 3,
        "button": "START_AUDITING",
        "process": "util_audit_gen.create_audit_trigger",
        "authorization": "audit-administrator",
        "placement": "dialogFooter"
      },
      {
        "page": 3,
        "button": "RECREATE_TRIGGER",
        "process": "util_audit_gen.create_audit_trigger",
        "authorization": "audit-administrator",
        "placement": "dialogFooter"
      },
      {
        "page": 3,
        "button": "PAUSE_AUDITING",
        "process": "util_audit.disable_table",
        "authorization": "audit-administrator",
        "placement": "dialogFooter"
      },
      {
        "page": 3,
        "button": "RESUME_AUDITING",
        "process": "util_audit.enable_table",
        "authorization": "audit-administrator",
        "placement": "dialogFooter"
      },
      {
        "page": 3,
        "button": "STOP_AUDITING",
        "process": "util_audit_gen.drop_audit_trigger",
        "authorization": "audit-administrator",
        "placement": "dialogFooter"
      },
      {
        "page": 3,
        "button": "SAVE_IGNORED",
        "process": "util_audit_gen.set_table_ignored_columns",
        "authorization": "audit-administrator",
        "placement": "region Ignored Columns"
      },
      {
        "page": 5,
        "button": "PREVIEW_RESTORE",
        "process": "util_audit.restore_row(p_preview=>true)",
        "authorization": "audit-administrator",
        "placement": "region Restore"
      },
      {
        "page": 5,
        "button": "RESTORE",
        "process": "util_audit.restore_row",
        "authorization": "audit-administrator",
        "placement": "region Restore"
      },
      {
        "page": 8,
        "button": "PURGE_HISTORY",
        "process": "util_audit.purge",
        "placement": "region Purge Audit History"
      },
      {
        "page": 8,
        "button": "PURGE_ERRORS",
        "process": "util_audit.purge_errors",
        "placement": "region Purge Errors"
      },
      {
        "page": 8,
        "button": "RECREATE_ALL",
        "process": "util_audit_gen.recreate_all_triggers",
        "placement": "region Re-create All Triggers"
      }
    ],
    "parentChildContext": [
      {
        "page": 6,
        "parentRegion": "Row",
        "contextItems": [
          "P6_TABLE_NAME",
          "P6_PK_VALUE"
        ],
        "childRegions": [
          "Timeline",
          "All Column Changes"

          },
          {
            "behavior": "page-level create",
            "excluded": true,
            "reason": "audit rows are read-only"
          }
        ]
      }
    ],
    "validations": [
      {
        "page": 8,
        "item": "P8_PURGE_BEFORE",
        "rule": "required when request = PURGE_HISTORY"
      },
      {
        "page": 8,
        "item": "P8_ERRORS_BEFORE",
        "rule": "required when request = PURGE_ERRORS"
      }
    ],
    "formContext": [
